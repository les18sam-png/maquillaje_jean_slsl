<%- include('../partials/header', { title }) %>

<div class="page-wrapper">

  <!-- Encabezado -->
  <div class="page-header">
    <div class="page-header__left">
      <h1 class="page-title">Administración</h1>
      <span class="page-subtitle">Gestión del sistema SmartVenta</span>
    </div>
  </div>

  <!-- Tarjetas de acceso rápido -->
  <div class="admin-grid">

    <a href="/admin/usuarios" class="admin-card">
      <div class="admin-card__icon admin-card__icon--usuarios">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
      </div>
      <div class="admin-card__body">
        <h2 class="admin-card__title">Usuarios</h2>
        <p class="admin-card__desc">Gestiona los cajeros y administradores del sistema</p>
      </div>
      <svg class="admin-card__arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
    </a>

   

    <a href="/admin/configuracion" class="admin-card">
      <div class="admin-card__icon admin-card__icon--config">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="3"/><path d="M19.07 4.93A10 10 0 1 1 4.93 19.07 10 10 0 0 1 19.07 4.93z"/><path d="M12 1v3M12 20v3M4.22 4.22l2.12 2.12M17.66 17.66l2.12 2.12M1 12h3M20 12h3M4.22 19.78l2.12-2.12M17.66 6.34l2.12-2.12"/></svg>
      </div>
      <div class="admin-card__body">
        <h2 class="admin-card__title">Configuración</h2>
        <p class="admin-card__desc">Datos de la sucursal y configuración de cajas</p>
      </div>
      <svg class="admin-card__arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
    </a>

  </div>

</div>

<style>
.admin-grid {
  display: flex;
  flex-direction: column;
  gap: 12px;
  max-width: 640px;
}

.admin-card {
  display: flex;
  align-items: center;
  gap: 18px;
  background: #fff;
  border-radius: 14px;
  padding: 20px 22px;
  box-shadow: 0 1px 4px rgba(60,40,50,.07);
  text-decoration: none;
  border: 1.5px solid transparent;
  transition: border-color .18s, box-shadow .18s, transform .18s;
}
.admin-card:hover {
  border-color: #FFB7C5;
  box-shadow: 0 4px 16px rgba(108,8,32,.1);
  transform: translateX(4px);
}

.admin-card__icon {
  width: 58px;
  height: 58px;
  border-radius: 14px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.admin-card__icon--usuarios    { background: #F7E7CE; color: #B5294E; }
.admin-card__icon--roles       { background: #F2DCDB; color: #6C0820; }
.admin-card__icon--config      { background: #dbeafe; color: #1e40af; }

.admin-card__body { flex: 1; }
.admin-card__title {
  font-family: 'Playfair Display', serif;
  font-size: 1rem;
  font-weight: 700;
  color: #3D5D91;
  margin: 0 0 4px;
}
.admin-card__desc {
  font-size: .82rem;
  color: #888;
  margin: 0;
}
.admin-card__arrow { color: #ccc; flex-shrink: 0; }
.admin-card:hover .admin-card__arrow { color: #B5294E; }
</style>

<%- include('../partials/footer') %>