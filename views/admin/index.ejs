<%- include('../partials/header', { title }) %>

<div class="page-wrapper">

  <div class="page-header">
    <div class="page-header__left">
      <h1 class="page-title">Administración</h1>
      <span class="page-subtitle">Gestión del sistema SmartVenta</span>
    </div>
  </div>

  <!-- GENERAL -->
  <div class="admin-seccion">
    <div class="admin-seccion__label">General</div>
    <div class="admin-grid">

      <a href="/admin/usuarios" class="admin-card">
        <div class="admin-card__icon admin-card__icon--usuarios">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        </div>
        <div class="admin-card__body">
          <h2 class="admin-card__title">Usuarios</h2>
          <p class="admin-card__desc">Cajeros y administradores</p>
        </div>
        <svg class="admin-card__arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
      </a>

      <a href="/admin/cajas" class="admin-card">
        <div class="admin-card__icon admin-card__icon--cajas">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
        </div>
        <div class="admin-card__body">
          <h2 class="admin-card__title">Cajas</h2>
          <p class="admin-card__desc">Cajas de venta y verificador</p>
        </div>
        <svg class="admin-card__arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
      </a>

      <a href="/admin/configuracion" class="admin-card">
        <div class="admin-card__icon admin-card__icon--config">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="3"/><path d="M19.07 4.93A10 10 0 1 1 4.93 19.07 10 10 0 0 1 19.07 4.93z"/><path d="M12 1v3M12 20v3M4.22 4.22l2.12 2.12M17.66 17.66l2.12 2.12M1 12h3M20 12h3M4.22 19.78l2.12-2.12M17.66 6.34l2.12-2.12"/></svg>
        </div>
        <div class="admin-card__body">
          <h2 class="admin-card__title">Configuración</h2>
          <p class="admin-card__desc">Datos de la sucursal</p>
        </div>
        <svg class="admin-card__arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
      </a>

    </div>
  </div>

  <!-- OPERACIÓN -->
  <div class="admin-seccion">
    <div class="admin-seccion__label">Operación</div>
    <div class="admin-grid">

      <a href="/admin/corte" class="admin-card">
        <div class="admin-card__icon admin-card__icon--corte">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="4" width="18" height="16" rx="2"/><line x1="7" y1="9" x2="17" y2="9"/><line x1="9" y1="13" x2="9" y2="13"/><line x1="12" y1="13" x2="12" y2="13"/><line x1="15" y1="13" x2="15" y2="13"/></svg>
        </div>
        <div class="admin-card__body">
          <h2 class="admin-card__title">Corte de caja</h2>
          <p class="admin-card__desc">Cierre por turno</p>
        </div>
        <svg class="admin-card__arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
      </a>

      

    </div>
  </div>

  <!-- PERSONALIZACIÓN -->
  <div class="admin-seccion">
    <div class="admin-seccion__label">Personalización</div>
    <div class="admin-grid">

      <a href="/admin/logotipo" class="admin-card">
        <div class="admin-card__icon admin-card__icon--logo">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
        </div>
        <div class="admin-card__body">
          <h2 class="admin-card__title">Logotipo</h2>
          <p class="admin-card__desc">Imagen del programa</p>
        </div>
        <svg class="admin-card__arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
      </a>

      <a href="/admin/ticket" class="admin-card">
        <div class="admin-card__icon admin-card__icon--ticket">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
        </div>
        <div class="admin-card__body">
          <h2 class="admin-card__title">Ticket</h2>
          <p class="admin-card__desc">Encabezado y pie</p>
        </div>
        <svg class="admin-card__arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
      </a>

    </div>
  </div>

  <!-- DATOS -->
  <div class="admin-seccion">
    <div class="admin-seccion__label">Datos</div>
    <div class="admin-grid">

      <a href="/admin/respaldo" class="admin-card">
        <div class="admin-card__icon admin-card__icon--respaldo">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"/><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/></svg>
        </div>
        <div class="admin-card__body">
          <h2 class="admin-card__title">Respaldo</h2>
          <p class="admin-card__desc">Exportar datos</p>
        </div>
        <svg class="admin-card__arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
      </a>

    </div>
  </div>

</div>

<style>
.admin-seccion { margin-bottom: 24px; }
.admin-seccion__label {
  font-size: .72rem;
  font-weight: 700;
  letter-spacing: .08em;
  text-transform: uppercase;
  color: #B06080;
  margin-bottom: 10px;
}

.admin-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
  gap: 12px;
  max-width: 860px;
}

.admin-card {
  display: flex;
  align-items: center;
  gap: 14px;
  background: #fff;
  border-radius: 14px;
  padding: 16px 18px;
  box-shadow: 0 1px 4px rgba(60,40,50,.07);
  text-decoration: none;
  border: 1.5px solid transparent;
  transition: border-color .18s, box-shadow .18s, transform .18s;
}
.admin-card:hover {
  border-color: #FFB7C5;
  box-shadow: 0 4px 16px rgba(108,8,32,.1);
  transform: translateX(4px);
}

.admin-card__icon {
  width: 48px;
  height: 48px;
  border-radius: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.admin-card__icon--usuarios  { background: #F7E7CE; color: #B5294E; }
.admin-card__icon--cajas     { background: #e8f5e9; color: #2e7d32; }
.admin-card__icon--config    { background: #dbeafe; color: #1e40af; }
.admin-card__icon--corte     { background: #FCE4EE; color: #C8215A; }
.admin-card__icon--articulos { background: #ede9fe; color: #5b21b6; }
.admin-card__icon--logo      { background: #fef3c7; color: #92400e; }
.admin-card__icon--ticket    { background: #fef3c7; color: #92400e; }
.admin-card__icon--respaldo  { background: #dbeafe; color: #1e40af; }

.admin-card__body { flex: 1; min-width: 0; }
.admin-card__title {
  font-family: 'Playfair Display', serif;
  font-size: .98rem;
  font-weight: 700;
  color: #3D5D91;
  margin: 0 0 2px;
}
.admin-card__desc {
  font-size: .8rem;
  color: #888;
  margin: 0;
}
.admin-card__arrow { color: #ccc; flex-shrink: 0; }
.admin-card:hover .admin-card__arrow { color: #B5294E; }
</style>

<%- include('../partials/footer') %>