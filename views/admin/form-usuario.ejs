<%- include('../partials/header', { title }) %>

<div class="page-wrapper page-wrapper--narrow">

  <!-- Breadcrumb -->
  <nav class="breadcrumb">
    <a href="/admin" class="breadcrumb__link">Administración</a>
    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
    <a href="/admin/usuarios" class="breadcrumb__link">Usuarios</a>
    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
    <span class="breadcrumb__current"><%= modoEdicion ? 'Editar' : 'Nuevo' %></span>
  </nav>

  <!-- Encabezado -->
  <div class="page-header">
    <div class="page-header__left">
      <h1 class="page-title"><%= modoEdicion ? 'Editar usuario' : 'Nuevo usuario' %></h1>
    </div>
    <div class="page-header__right">
      <a href="/admin/usuarios" class="btn btn-ghost">Cancelar</a>
    </div>
  </div>

  <!-- Error -->
  <% const errorParam = (typeof query !== 'undefined' ? query?.error : null) || ''; %>
  <% if (errorParam === 'fallo') { %>
    <div class="alert alert--error">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
      No se pudo guardar el usuario. Verifica los datos.
    </div>
  <% } %>

  <form
    method="POST"
    action="<%= modoEdicion ? `/admin/usuarios/${usuario.id}/editar` : '/admin/usuarios/nuevo' %>"
    class="form-card"
    id="form-usuario"
    novalidate
  >

    <!-- Datos básicos -->
    <div class="form-section">
      <h2 class="form-section__title">Datos del usuario</h2>

      <div class="form-group form-group--full">
        <label class="form-label" for="nombre_completo">
          Nombre completo <span class="required">*</span>
        </label>
        <input
          type="text"
          id="nombre_completo"
          name="nombre_completo"
          class="form-control"
          value="<%= usuario?.nombre_completo || '' %>"
          placeholder="Ej. María García López"
          required
          maxlength="150"
          autofocus
        >
        <span class="form-error" id="err-nombre"></span>
      </div>

      <div class="form-row">
        <div class="form-group">
          <label class="form-label" for="nombre_usuario">
            Usuario <span class="required">*</span>
          </label>
          <input
            type="text"
            id="nombre_usuario"
            name="nombre_usuario"
            class="form-control"
            value="<%= usuario?.nombre_usuario || '' %>"
            placeholder="cajero01"
            required
            maxlength="60"
            autocomplete="off"
          >
          <span class="form-hint">Sin espacios</span>
          <span class="form-error" id="err-usuario"></span>
        </div>

        <div class="form-group">
          <label class="form-label" for="rol_id">
            Rol <span class="required">*</span>
          </label>
          <% if (roles.length === 0) { %>
            <div class="alert alert--warning" style="margin:0;font-size:.8rem;">
              No hay roles. <a href="/admin/roles" class="link">Ver roles</a>
            </div>
          <% } else { %>
            <select name="rol_id" id="rol_id" class="form-control" required>
              <option value="">Selecciona un rol…</option>
              <% roles.forEach(r => { %>
                <option value="<%= r.id %>" <%= usuario?.rol_id === r.id ? 'selected' : '' %>>
                  <%= r.nombre %>
                </option>
              <% }) %>
            </select>
          <% } %>
          <span class="form-error" id="err-rol"></span>
        </div>
      </div>

    </div>

    <!-- Contraseña — solo nuevo -->
    <% if (!modoEdicion) { %>
    <div class="form-section">
      <h2 class="form-section__title">Contraseña</h2>
      <div class="form-row">
        <div class="form-group">
          <label class="form-label" for="contrasena">
            Contraseña <span class="required">*</span>
          </label>
          <div class="input-password-wrap">
            <input
              type="password"
              id="contrasena"
              name="contrasena"
              class="form-control"
              placeholder="Mínimo 6 caracteres"
              required
              minlength="6"
              autocomplete="new-password"
            >
            <button type="button" class="input-password-toggle" onclick="togglePass('contrasena')" tabindex="-1">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
            </button>
          </div>
          <span class="form-error" id="err-contrasena"></span>
        </div>

        <div class="form-group">
          <label class="form-label" for="contrasena2">
            Confirmar <span class="required">*</span>
          </label>
          <div class="input-password-wrap">
            <input
              type="password"
              id="contrasena2"
              name="contrasena2"
              class="form-control"
              placeholder="Repite la contraseña"
              required
              autocomplete="new-password"
            >
            <button type="button" class="input-password-toggle" onclick="togglePass('contrasena2')" tabindex="-1">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
            </button>
          </div>
          <span class="form-error" id="err-contrasena2"></span>
        </div>
      </div>
    </div>
    <% } %>

    <!-- Tabs de permisos -->
    <div class="form-section">
      <h2 class="form-section__title">Permisos</h2>
      <p class="form-hint" style="margin-bottom:14px;">
        Los permisos se heredan del rol seleccionado. Aquí puedes consultarlos — para modificarlos, cambia el rol.
      </p>

      <!-- Tabs -->
      <div class="permisos-tabs">
        <button type="button" class="permisos-tab permisos-tab--active" onclick="switchTab(this, 'tab-ventas')">Ventas</button>
        <button type="button" class="permisos-tab" onclick="switchTab(this, 'tab-clientes')">Clientes</button>
        <button type="button" class="permisos-tab" onclick="switchTab(this, 'tab-productos')">Productos</button>
        <button type="button" class="permisos-tab" onclick="switchTab(this, 'tab-inventario')">Inventario</button>
        <button type="button" class="permisos-tab" onclick="switchTab(this, 'tab-otros')">Otros</button>
      </div>

      <!-- Tab Ventas -->
      <div class="permisos-tab-content" id="tab-ventas">
        <div class="permisos-check-grid">
          <label class="permiso-check">
            <input type="checkbox" name="perm_corte_caja" disabled
              <%= usuario?.roles?.perm_corte_caja ? 'checked' : '' %>>
            <span>Corte de caja</span>
          </label>
          <label class="permiso-check">
            <input type="checkbox" name="perm_cancelar_tickets" disabled
              <%= usuario?.roles?.perm_cancelar_tickets ? 'checked' : '' %>>
            <span>Cancelar tickets</span>
          </label>
          <label class="permiso-check">
            <input type="checkbox" name="perm_descuentos" disabled
              <%= usuario?.roles?.perm_descuentos ? 'checked' : '' %>>
            <span>Aplicar descuentos</span>
          </label>
        </div>
      </div>

      <!-- Tab Clientes -->
      <div class="permisos-tab-content" id="tab-clientes" style="display:none">
        <div class="permisos-check-grid">
          <label class="permiso-check">
            <input type="checkbox" name="perm_clientes" disabled
              <%= usuario?.roles?.perm_clientes ? 'checked' : '' %>>
            <span>Gestionar clientes</span>
          </label>
        </div>
      </div>

      <!-- Tab Productos -->
      <div class="permisos-tab-content" id="tab-productos" style="display:none">
        <div class="permisos-check-grid">
          <label class="permiso-check">
            <input type="checkbox" name="perm_modificar_precios" disabled
              <%= usuario?.roles?.perm_modificar_precios ? 'checked' : '' %>>
            <span>Modificar precios</span>
          </label>
          <label class="permiso-check">
            <input type="checkbox" name="perm_promociones" disabled
              <%= usuario?.roles?.perm_promociones ? 'checked' : '' %>>
            <span>Promociones</span>
          </label>
        </div>
      </div>

      <!-- Tab Inventario -->
      <div class="permisos-tab-content" id="tab-inventario" style="display:none">
        <div class="permisos-check-grid">
          <label class="permiso-check">
            <input type="checkbox" name="perm_inventario_entrada" disabled
              <%= usuario?.roles?.perm_inventario_entrada ? 'checked' : '' %>>
            <span>Entrada de mercancía</span>
          </label>
          <label class="permiso-check">
            <input type="checkbox" name="perm_inventario_ajuste" disabled
              <%= usuario?.roles?.perm_inventario_ajuste ? 'checked' : '' %>>
            <span>Ajuste de inventario</span>
          </label>
          <label class="permiso-check">
            <input type="checkbox" name="perm_kardex" disabled
              <%= usuario?.roles?.perm_kardex ? 'checked' : '' %>>
            <span>Ver kardex</span>
          </label>
        </div>
      </div>

      <!-- Tab Otros -->
      <div class="permisos-tab-content" id="tab-otros" style="display:none">
        <div class="permisos-check-grid">
          <label class="permiso-check">
            <input type="checkbox" name="perm_reportes" disabled
              <%= usuario?.roles?.perm_reportes ? 'checked' : '' %>>
            <span>Ver reportes</span>
          </label>
          <label class="permiso-check">
            <input type="checkbox" name="perm_exportar" disabled
              <%= usuario?.roles?.perm_exportar ? 'checked' : '' %>>
            <span>Exportar datos</span>
          </label>
          <label class="permiso-check">
            <input type="checkbox" name="perm_administrar" disabled
              <%= usuario?.roles?.perm_administrar ? 'checked' : '' %>>
            <span>Administrar sistema</span>
          </label>
        </div>
      </div>

    </div>

    <!-- Botones -->
    <div class="form-footer">
      <button type="submit" class="btn btn-primary btn-lg">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
        <%= modoEdicion ? 'Guardar cambios' : 'Crear usuario' %>
      </button>
    </div>

  </form>
</div>

<style>
.permisos-tabs {
  display: flex;
  gap: 0;
  border-bottom: 2px solid #F2DCDB;
  margin-bottom: 16px;
}
.permisos-tab {
  padding: 8px 16px;
  background: none;
  border: none;
  border-bottom: 2px solid transparent;
  margin-bottom: -2px;
  font-size: .82rem;
  font-weight: 600;
  color: #aaa;
  cursor: pointer;
  transition: color .15s, border-color .15s;
  font-family: 'DM Sans', sans-serif;
}
.permisos-tab:hover { color: #B5294E; }
.permisos-tab--active {
  color: #6C0820;
  border-bottom-color: #6C0820;
}

.permisos-check-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
  gap: 10px;
  padding: 4px 0;
}
.permiso-check {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 10px 14px;
  border: 1.5px solid #E0C8C8;
  border-radius: 8px;
  cursor: default;
  font-size: .84rem;
  color: #555;
  background: #fafafa;
}
.permiso-check input[type="checkbox"] {
  width: 16px;
  height: 16px;
  accent-color: #6C0820;
  flex-shrink: 0;
}
.permiso-check input:checked ~ span { color: #065f46; font-weight: 600; }

.input-password-wrap { position: relative; }
.input-password-wrap .form-control { padding-right: 40px; }
.input-password-toggle {
  position: absolute;
  right: 10px;
  top: 50%;
  transform: translateY(-50%);
  background: none;
  border: none;
  color: #aaa;
  cursor: pointer;
  padding: 4px;
  display: flex;
}
.input-password-toggle:hover { color: #6C0820; }
</style>

<script>
  function switchTab(btn, tabId) {
    document.querySelectorAll('.permisos-tab').forEach(t => t.classList.remove('permisos-tab--active'));
    document.querySelectorAll('.permisos-tab-content').forEach(c => c.style.display = 'none');
    btn.classList.add('permisos-tab--active');
    document.getElementById(tabId).style.display = 'block';
  }

  function togglePass(id) {
    const input = document.getElementById(id);
    input.type  = input.type === 'password' ? 'text' : 'password';
  }

  document.getElementById('form-usuario').addEventListener('submit', e => {
    let valid = true;

    const nombre    = document.getElementById('nombre_completo');
    const errNombre = document.getElementById('err-nombre');
    if (!nombre.value.trim()) {
      errNombre.textContent = 'El nombre es obligatorio';
      nombre.classList.add('form-control--error');
      valid = false;
    } else {
      errNombre.textContent = '';
      nombre.classList.remove('form-control--error');
    }

    const usuario    = document.getElementById('nombre_usuario');
    const errUsuario = document.getElementById('err-usuario');
    if (!usuario.value.trim()) {
      errUsuario.textContent = 'El usuario es obligatorio';
      usuario.classList.add('form-control--error');
      valid = false;
    } else if (/\s/.test(usuario.value)) {
      errUsuario.textContent = 'No puede contener espacios';
      usuario.classList.add('form-control--error');
      valid = false;
    } else {
      errUsuario.textContent = '';
      usuario.classList.remove('form-control--error');
    }

    <% if (!modoEdicion) { %>
    const pass     = document.getElementById('contrasena');
    const pass2    = document.getElementById('contrasena2');
    const errPass  = document.getElementById('err-contrasena');
    const errPass2 = document.getElementById('err-contrasena2');

    if (!pass.value || pass.value.length < 6) {
      errPass.textContent = 'Mínimo 6 caracteres';
      pass.classList.add('form-control--error');
      valid = false;
    } else {
      errPass.textContent = '';
      pass.classList.remove('form-control--error');
    }

    if (pass.value !== pass2.value) {
      errPass2.textContent = 'Las contraseñas no coinciden';
      pass2.classList.add('form-control--error');
      valid = false;
    } else {
      errPass2.textContent = '';
      pass2.classList.remove('form-control--error');
    }
    <% } %>

    if (!valid) e.preventDefault();
  });
</script>

<%- include('../partials/footer') %>