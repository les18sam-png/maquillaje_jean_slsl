<%- include('../partials/header', { title }) %>

<div class="page-wrapper">

  <!-- Encabezado -->
  <div class="page-header">
    <div class="page-header__left">
      <h1 class="page-title">Cajas</h1>
      <span class="page-subtitle">Cajas de venta y estaciones de verificador de precios de esta sucursal</span>
    </div>
    <div class="page-header__right">
      <button class="btn btn-primary" onclick="abrirModalCrear()">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        Nueva Caja
      </button>
    </div>
  </div>

  <!-- Toasts -->
  <% if (toast === 'creada') { %>
    <div class="alert alert--success">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
      Caja creada correctamente.
    </div>
  <% } %>
  <% if (toast === 'actualizada') { %>
    <div class="alert alert--success">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
      Caja actualizada correctamente.
    </div>
  <% } %>
  <% if (error === 'fallo') { %>
    <div class="alert alert--error">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
      No se pudo guardar la caja. Intenta de nuevo.
    </div>
  <% } %>
  <% if (error === 'no_encontrada') { %>
    <div class="alert alert--error">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
      La caja no existe.
    </div>
  <% } %>

  <!-- Tabla -->
  <div class="card">
    <div class="card__header">
      <h3 class="card__title">Cajas configuradas</h3>
    </div>
    <% if (cajas.length === 0) { %>
      <div style="padding:40px;text-align:center;color:#aaa">
        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#ddd" stroke-width="1.5" style="margin-bottom:12px"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
        <p style="margin:0;font-size:.9rem">No hay cajas configuradas aún.</p>
        <button class="btn btn-primary" style="margin-top:16px" onclick="abrirModalCrear()">Crear primera caja</button>
      </div>
    <% } else { %>
      <table class="data-table">
        <thead>
          <tr>
            <th>Nombre</th>
            <th>Tipo</th>
            <th>Impresora</th>
            <th>Estado</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% cajas.forEach(caja => { %>
            <tr>
              <td class="fw-medium"><%= caja.nombre %></td>
              <td>
                <% if (caja.es_verificador) { %>
                  <span class="badge badge--navy">Verificador</span>
                <% } else { %>
                  <span class="badge badge--burgundy">Venta</span>
                <% } %>
              </td>
              <td>
                <% if (caja.impresora_tipo) { %>
                  <span style="font-size:.82rem;color:#555">
                    <%= caja.impresora_tipo === 'usb' ? 'USB — ' + caja.impresora_valor : 'Red — ' + caja.impresora_valor + ':' + (caja.impresora_puerto || 9100) %>
                  </span>
                <% } else { %>
                  <span style="font-size:.8rem;color:#ccc">Sin configurar</span>
                <% } %>
              </td>
              <td>
                <% if (caja.activa) { %>
                  <span class="badge badge--success">Activa</span>
                <% } else { %>
                  <span class="badge badge--neutral">Inactiva</span>
                <% } %>
              </td>
              <td style="text-align:right">
                <button class="btn btn-ghost btn-sm"
                  onclick='abrirModalEditar(<%- JSON.stringify(caja) %>)'>
                  Editar
                </button>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>
  </div>

</div>

<!-- Modal crear/editar caja -->
<div class="modal-overlay" id="modal-overlay" onclick="cerrarModal()" style="display:none"></div>
<div class="modal-card" id="modal-caja" style="display:none">
  <div class="modal-card__header">
    <h2 class="modal-card__title" id="modal-titulo">Nueva Caja</h2>
    <button class="modal-card__close" onclick="cerrarModal()">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
  </div>

  <form method="POST" action="/admin/cajas" id="form-caja">
    <input type="hidden" name="_method" id="form-method" value="POST">
    <div class="modal-card__body">

      <div class="form-group">
        <label class="form-label" for="nombre">
          Nombre de la caja <span class="required">*</span>
        </label>
        <input
          type="text" id="nombre" name="nombre"
          class="form-control" placeholder="Ej. Caja 1, Mostrador Norte…"
          maxlength="60" required
        >
      </div>

      <div class="form-group" style="margin-top:16px">
        <label class="form-label">Tipo</label>
        <div class="tipo-caja-opts">
          <label class="tipo-caja-opt" id="opt-venta">
            <input type="radio" name="es_verificador" value="false" checked onchange="actualizarTipo(this)">
            <div class="tipo-caja-opt__icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
            </div>
            <div>
              <div class="tipo-caja-opt__label">Caja de venta</div>
              <div class="tipo-caja-opt__hint">Procesa ventas y cobros</div>
            </div>
          </label>

          <label class="tipo-caja-opt" id="opt-verificador">
            <input type="radio" name="es_verificador" value="true" onchange="actualizarTipo(this)">
            <div class="tipo-caja-opt__icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            </div>
            <div>
              <div class="tipo-caja-opt__label">Verificador de precios</div>
              <div class="tipo-caja-opt__hint">Solo consulta, no vende</div>
            </div>
          </label>
        </div>
      </div>

      <!-- Estado (solo visible al editar) -->
      <div class="form-group" style="margin-top:16px" id="grupo-activa">
        <label class="ticket-check">
          <input type="checkbox" id="activa" name="activa" value="true" checked>
          <span>Caja activa</span>
        </label>
      </div>

      <!-- Configuración de impresora -->
      <div class="form-group" style="margin-top:20px; padding-top:16px; border-top:1px solid #F2DCDB;">
        <label class="form-label">Impresora de tickets</label>
        <select id="impresora_tipo" name="impresora_tipo" class="form-control" onchange="actualizarCamposImpresora()">
          <option value="">Sin configurar</option>
          <option value="usb">USB (compartida en Windows)</option>
          <option value="red">Red (IP + puerto)</option>
        </select>

        <div id="campos-usb" style="display:none; margin-top:10px;">
          <label class="form-label">Nombre del recurso compartido</label>
          <input type="text" id="impresora_valor_usb" class="form-control" placeholder="Ej. BIXOLON">
          <span class="form-hint">Debe coincidir exacto con el nombre configurado en Windows → Impresoras → Uso compartido.</span>
        </div>

        <div id="campos-red" style="display:none; margin-top:10px;">
          <div style="display:flex; gap:10px;">
            <div style="flex:2">
              <label class="form-label">Dirección IP</label>
              <input type="text" id="impresora_valor_red" class="form-control" placeholder="192.168.1.100">
            </div>
            <div style="flex:1">
              <label class="form-label">Puerto</label>
              <input type="number" id="impresora_puerto" class="form-control" placeholder="9100" value="9100">
            </div>
          </div>
        </div>

        <!-- Campo real que se envía, sincronizado según el tipo elegido -->
        <input type="hidden" id="impresora_valor" name="impresora_valor">
      </div>

    </div>

    <div class="modal-card__footer">
      <button type="button" class="btn btn-ghost" onclick="cerrarModal()">Cancelar</button>
      <button type="submit" class="btn btn-primary" id="btn-guardar">Crear Caja</button>
    </div>
  </form>
</div>

<style>
  .modal-overlay {
    position: fixed; inset: 0;
    background: rgba(74,5,23,.55);
    backdrop-filter: blur(2px);
    z-index: 100;
  }
  .modal-card {
    position: fixed;
    top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    width: min(460px, calc(100vw - 32px));
    max-height: 90vh;
    overflow-y: auto;
    background: #fff;
    border-radius: 18px;
    box-shadow: 0 24px 64px rgba(0,0,0,.25);
    z-index: 101;
    animation: modalIn .18s ease;
  }
  @keyframes modalIn {
    from { opacity:0; transform:translate(-50%,-48%) }
    to   { opacity:1; transform:translate(-50%,-50%) }
  }
  .modal-card__header {
    display: flex; align-items: center; justify-content: space-between;
    padding: 22px 24px 0;
  }
  .modal-card__title {
    font-family: 'Playfair Display', serif;
    font-size: 1.25rem; color: #6C0820; margin: 0;
  }
  .modal-card__close {
    background: none; border: none; color: #aaa;
    cursor: pointer; padding: 4px; border-radius: 6px;
  }
  .modal-card__close:hover { background: #f5f5f5; color: #6C0820; }
  .modal-card__body   { padding: 20px 24px; }
  .modal-card__footer {
    padding: 0 24px 22px;
    display: flex; justify-content: flex-end; gap: 10px;
  }

  .tipo-caja-opts { display: flex; flex-direction: column; gap: 10px; margin-top: 6px; }
  .tipo-caja-opt {
    display: flex; align-items: center; gap: 12px;
    border: 2px solid #eee; border-radius: 10px;
    padding: 12px 14px; cursor: pointer; transition: border-color .15s;
  }
  .tipo-caja-opt input[type=radio] { display: none; }
  .tipo-caja-opt.selected { border-color: #6C0820; background: #fdf5f7; }
  .tipo-caja-opt__icon { color: #6C0820; flex-shrink: 0; }
  .tipo-caja-opt__label { font-weight: 600; font-size: .88rem; color: #1a1a2e; }
  .tipo-caja-opt__hint  { font-size: .78rem; color: #aaa; }

  .ticket-check { display: flex; align-items: center; gap: 8px; font-size: .85rem; color: #555; cursor: pointer; }
  .ticket-check input { accent-color: #C8215A; width: 16px; height: 16px; }
</style>

<script>
  let cajaEditandoId = null;

  function abrirModalCrear() {
    cajaEditandoId = null;
    document.getElementById('modal-titulo').textContent = 'Nueva Caja';
    document.getElementById('btn-guardar').textContent = 'Crear Caja';
    document.getElementById('form-caja').action = '/admin/cajas';
    document.getElementById('form-method').value = 'POST';
    document.getElementById('grupo-activa').style.display = 'none';

    document.getElementById('nombre').value = '';
    document.querySelector('input[name=es_verificador][value=false]').checked = true;
    document.getElementById('activa').checked = true;
    document.getElementById('impresora_tipo').value = '';
    document.getElementById('impresora_valor_usb').value = '';
    document.getElementById('impresora_valor_red').value = '';
    document.getElementById('impresora_puerto').value = '9100';

    document.querySelectorAll('.tipo-caja-opt').forEach(el => el.classList.remove('selected'));
    document.getElementById('opt-venta').classList.add('selected');

    actualizarCamposImpresora();
    abrirModalBase();
    document.getElementById('nombre').focus();
  }

  function abrirModalEditar(caja) {
    cajaEditandoId = caja.id;
    document.getElementById('modal-titulo').textContent = 'Editar Caja';
    document.getElementById('btn-guardar').textContent = 'Guardar Cambios';
    document.getElementById('form-caja').action = `/admin/cajas/${caja.id}?_method=PUT`;
    document.getElementById('form-method').value = 'PUT';
    document.getElementById('grupo-activa').style.display = 'block';

    document.getElementById('nombre').value = caja.nombre;
    document.querySelector(`input[name=es_verificador][value=${caja.es_verificador ? 'true' : 'false'}]`).checked = true;
    document.getElementById('activa').checked = caja.activa;

    document.getElementById('impresora_tipo').value = caja.impresora_tipo || '';
    document.getElementById('impresora_valor_usb').value = caja.impresora_tipo === 'usb' ? (caja.impresora_valor || '') : '';
    document.getElementById('impresora_valor_red').value = caja.impresora_tipo === 'red' ? (caja.impresora_valor || '') : '';
    document.getElementById('impresora_puerto').value = caja.impresora_puerto || '9100';

    document.querySelectorAll('.tipo-caja-opt').forEach(el => el.classList.remove('selected'));
    document.getElementById(caja.es_verificador ? 'opt-verificador' : 'opt-venta').classList.add('selected');

    actualizarCamposImpresora();
    abrirModalBase();
  }

  function abrirModalBase() {
    document.getElementById('modal-overlay').style.display = 'block';
    document.getElementById('modal-caja').style.display   = 'block';
  }

  function cerrarModal() {
    document.getElementById('modal-overlay').style.display = 'none';
    document.getElementById('modal-caja').style.display   = 'none';
  }

  function actualizarTipo(radio) {
    document.querySelectorAll('.tipo-caja-opt').forEach(el => el.classList.remove('selected'));
    radio.closest('.tipo-caja-opt').classList.add('selected');
  }

  function actualizarCamposImpresora() {
    const tipo = document.getElementById('impresora_tipo').value;
    document.getElementById('campos-usb').style.display = tipo === 'usb' ? 'block' : 'none';
    document.getElementById('campos-red').style.display = tipo === 'red' ? 'block' : 'none';
  }

  // Antes de enviar el formulario, sincroniza el campo oculto "impresora_valor"
  // con el campo visible correspondiente según el tipo elegido.
  document.getElementById('form-caja').addEventListener('submit', () => {
    const tipo = document.getElementById('impresora_tipo').value;
    const valorField = document.getElementById('impresora_valor');
    if (tipo === 'usb') {
      valorField.value = document.getElementById('impresora_valor_usb').value;
    } else if (tipo === 'red') {
      valorField.value = document.getElementById('impresora_valor_red').value;
    } else {
      valorField.value = '';
    }
  });

  document.addEventListener('keydown', e => { if (e.key === 'Escape') cerrarModal(); });
</script>

<%- include('../partials/footer') %>