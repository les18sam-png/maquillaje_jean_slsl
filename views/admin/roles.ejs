<%- include('../partials/header', { title }) %>

<div class="page-wrapper">

  <!-- Breadcrumb -->
  <nav class="breadcrumb">
    <a href="/admin" class="breadcrumb__link">Administración</a>
    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
    <span class="breadcrumb__current">Roles y Permisos</span>
  </nav>

  <!-- Encabezado -->
  <div class="page-header">
    <div class="page-header__left">
      <h1 class="page-title">Roles y Permisos</h1>
      <span class="page-subtitle"><%= roles.length %> rol<%= roles.length !== 1 ? 'es' : '' %> configurado<%= roles.length !== 1 ? 's' : '' %></span>
    </div>
  </div>

  <!-- Lista de roles -->
  <% if (roles.length === 0) { %>
    <div class="empty-state">
      <div class="empty-state__icon">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
      </div>
      <p class="empty-state__title">No hay roles configurados</p>
      <p class="text-muted text-sm">Los roles se crean desde el backend.</p>
    </div>

  <% } else { %>
    <div class="roles-lista">
      <% roles.forEach(rol => {
        const permisos = [
          { key: 'perm_inventario_entrada',  label: 'Entrada inventario' },
          { key: 'perm_inventario_ajuste',   label: 'Ajuste inventario' },
          { key: 'perm_kardex',              label: 'Ver kardex' },
          { key: 'perm_corte_caja',          label: 'Corte de caja' },
          { key: 'perm_modificar_precios',   label: 'Modificar precios' },
          { key: 'perm_cancelar_tickets',    label: 'Cancelar tickets' },
          { key: 'perm_clientes',            label: 'Clientes' },
          { key: 'perm_descuentos',          label: 'Descuentos' },
          { key: 'perm_reportes',            label: 'Reportes' },
          { key: 'perm_exportar',            label: 'Exportar' },
          { key: 'perm_promociones',         label: 'Promociones' },
          { key: 'perm_administrar',         label: 'Administrar' },
        ];
      %>
      <div class="rol-card">
        <div class="rol-card__header">
          <div class="rol-card__icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          </div>
          <h2 class="rol-card__nombre"><%= rol.nombre %></h2>
        </div>

        <div class="rol-permisos">
          <% permisos.forEach(p => { %>
            <div class="permiso-item <%= rol[p.key] ? 'permiso-item--activo' : 'permiso-item--inactivo' %>">
              <% if (rol[p.key]) { %>
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
              <% } else { %>
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
              <% } %>
              <%= p.label %>
            </div>
          <% }) %>
        </div>
      </div>
      <% }) %>
    </div>

    <div class="alert alert--warning" style="max-width: 580px; margin-top: 16px;">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
      Los roles y permisos se gestionan desde el backend. Contacta al administrador del sistema para hacer cambios.
    </div>
  <% } %>

</div>

<style>
.roles-lista {
  display: flex;
  flex-direction: column;
  gap: 16px;
  max-width: 700px;
}

.rol-card {
  background: #fff;
  border-radius: 14px;
  box-shadow: 0 1px 4px rgba(60,40,50,.07);
  overflow: hidden;
}

.rol-card__header {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 16px 20px;
  background: linear-gradient(135deg, #6C0820, #B5294E);
  color: #fff;
}
.rol-card__icon {
  width: 38px;
  height: 38px;
  background: rgba(255,255,255,.15);
  border-radius: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.rol-card__nombre {
  font-family: 'Playfair Display', serif;
  font-size: 1.05rem;
  font-weight: 700;
  margin: 0;
}

.rol-permisos {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  padding: 16px 20px;
}

.permiso-item {
  display: flex;
  align-items: center;
  gap: 5px;
  padding: 4px 10px;
  border-radius: 20px;
  font-size: .75rem;
  font-weight: 600;
}
.permiso-item--activo {
  background: #d1fae5;
  color: #065f46;
}
.permiso-item--inactivo {
  background: #f3f4f6;
  color: #9ca3af;
}
</style>

<%- include('../partials/footer') %>