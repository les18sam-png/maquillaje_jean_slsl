<%- include('../partials/header', { title }) %>

<div class="page-wrapper">

  <!-- Encabezado -->
  <div class="page-header flex-between">
    <div class="page-header__left">
      <h1 class="page-title">Ventas del día y Devoluciones</h1>
      <span class="page-subtitle"><%= totalVentas %> venta<%= totalVentas !== 1 ? 's' : '' %> encontrada<%= totalVentas !== 1 ? 's' : '' %></span>
    </div>
    <a href="/venta" class="btn btn-ghost">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
      Volver
    </a>
  </div>

  <!-- Filtros -->
  <form method="GET" action="/ventas-dia" class="historial-filtros card">
    <div class="filtros-grid">

      <div class="form-group">
        <label class="form-label">Fecha inicio</label>
        <input type="date" name="fecha_inicio" class="form-control" value="<%= fechaInicio %>">
      </div>

      <div class="form-group">
        <label class="form-label">Fecha fin</label>
        <input type="date" name="fecha_fin" class="form-control" value="<%= fechaFin %>">
      </div>

      <div class="form-group">
        <label class="form-label">Estado</label>
        <select name="estado" class="form-control">
          <option value=""           <%= estado === ''           ? 'selected' : '' %>>Todos</option>
          <option value="completada" <%= estado === 'completada' ? 'selected' : '' %>>Completada</option>
          <option value="cancelada"  <%= estado === 'cancelada'  ? 'selected' : '' %>>Cancelada</option>
          <option value="devuelta"   <%= estado === 'devuelta'   ? 'selected' : '' %>>Devuelta</option>
        </select>
      </div>

      <div class="form-group">
        <label class="form-label">Método de pago</label>
        <select name="metodo" class="form-control">
          <option value=""              <%= metodo === ''              ? 'selected' : '' %>>Todos</option>
          <option value="efectivo"      <%= metodo === 'efectivo'      ? 'selected' : '' %>>Efectivo</option>
          <option value="tarjeta"       <%= metodo === 'tarjeta'       ? 'selected' : '' %>>Tarjeta</option>
          <option value="transferencia" <%= metodo === 'transferencia' ? 'selected' : '' %>>Transferencia</option>
          <option value="cheque"        <%= metodo === 'cheque'        ? 'selected' : '' %>>Cheque</option>
          <option value="mixto"         <%= metodo === 'mixto'         ? 'selected' : '' %>>Mixto</option>
        </select>
      </div>

    </div>

    <div class="filtros-acciones">
      <button type="submit" class="btn btn-primary">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        Buscar
      </button>
      <% if (fechaInicio || fechaFin || estado || metodo) { %>
        <a href="/ventas-dia" class="btn btn-ghost">Limpiar</a>
      <% } %>
    </div>
  </form>

  <!-- Tabla -->
  <% if (ventas.length === 0) { %>
    <div class="empty-state">
      <div class="empty-state__icon">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
      </div>
      <p class="empty-state__title">Sin resultados</p>
    </div>

  <% } else { %>
    <div class="table-wrapper">
      <table class="data-table">
        <thead>
          <tr>
            <th>Folio</th>
            <th>Fecha</th>
            <th>Cajero</th>
            <th>Cliente</th>
            <th>Método</th>
            <th>Estado</th>
            <th class="text-right">Total</th>
            <th class="th-actions">Acciones</th>
          </tr>
        </thead>
        <tbody>
          <% ventas.forEach(v => { %>
          <tr class="data-table__row" data-href="/ventas-dia/<%= v.id %>">
            <td>
              <code class="folio-badge">#<%= v.folio %></code>
            </td>
            <td class="text-sm">
              <%= new Date(v.creado_en + 'Z').toLocaleDateString('es-MX', { day:'2-digit', month:'short', year:'numeric', timeZone:'America/Mexico_City' }) %>
              <span class="text-muted text-xs">
                <%= new Date(v.creado_en + 'Z').toLocaleTimeString('es-MX', { hour:'2-digit', minute:'2-digit', timeZone:'America/Mexico_City' }) %>
              </span>
            </td>
            <td class="text-sm"><%= v.cajero_nombre || '—' %></td>
            <td class="text-sm"><%= v.cliente_nombre || 'Público general' %></td>
            <td>
              <span class="metodo-badge metodo-badge--<%= v.metodo_pago_principal %>">
                <% if (v.metodo_pago_principal === 'efectivo')      { %>Efectivo<% } %>
                <% if (v.metodo_pago_principal === 'tarjeta')       { %>Tarjeta<% } %>
                <% if (v.metodo_pago_principal === 'transferencia') { %>Transferencia<% } %>
                <% if (v.metodo_pago_principal === 'cheque')        { %>Cheque<% } %>
                <% if (v.metodo_pago_principal === 'mixto')         { %>Mixto<% } %>
              </span>
            </td>
            <td>
              <span class="badge badge--<%= v.estado === 'completada' ? 'success' : v.estado === 'cancelada' ? 'danger' : 'warning' %>">
                <%= v.estado.charAt(0).toUpperCase() + v.estado.slice(1) %>
              </span>
            </td>
            <td class="text-right fw-medium">
              $<%= Number(v.total).toLocaleString('es-MX', {minimumFractionDigits:2}) %>
            </td>
            <td class="td-actions" onclick="event.stopPropagation()">
              <a href="/ventas-dia/<%= v.id %>" class="icon-btn" title="Ver detalle">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
              </a>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>

</div>

<script>
  document.querySelectorAll('.data-table__row[data-href]').forEach(row => {
    row.addEventListener('click', () => { window.location.href = row.dataset.href; });
    row.style.cursor = 'pointer';
  });
</script>

<%- include('../partials/footer') %>