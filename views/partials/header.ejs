<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>SmartVenta — Maquillaje Jean</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600;700&family=Playfair+Display:wght@600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/main.css">
</head>
<body>

<aside class="sidebar">

  <div class="sidebar-logo">
    <div class="sidebar-logo-inner">
      <div class="sidebar-logo-icon">
        <svg viewBox="0 0 24 24" fill="white">
          <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 14H9V8h2v8zm4 0h-2V8h2v8z"/>
        </svg>
      </div>
      <div class="sidebar-logo-text">
        <span class="sidebar-logo-name">SmartVenta</span>
        <span class="sidebar-logo-sub">Maquillaje Jean</span>
      </div>
    </div>
  </div>

  <nav class="sidebar-nav">
    <span class="sidebar-section-label">Principal</span>

    <a href="/venta" class="sidebar-link <%= currentPath?.startsWith('/venta') ? 'sidebar-link--active' : '' %>">
      <span class="sidebar-link-icon">
        <svg viewBox="0 0 24 24"><path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 01-8 0"/></svg>
      </span>
      <span>Punto de Venta</span>
    </a>

    <a href="/clientes" class="sidebar-link <%= currentPath?.startsWith('/clientes') ? 'sidebar-link--active' : '' %>">
      <span class="sidebar-link-icon">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
          <circle cx="9" cy="7" r="4"/>
          <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
          <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
        </svg>
      </span>
      <span>Clientes</span>
    </a>

    <a href="/turnos" class="sidebar-link <%= currentPath?.startsWith('/turnos') ? 'sidebar-link--active' : '' %>">
      <span class="sidebar-link-icon">
        <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
      </span>
      <span>Turnos</span>
    </a>

    <a href="/historial" class="sidebar-link <%= currentPath?.startsWith('/historial') ? 'sidebar-link--active' : '' %>">
      <span class="sidebar-link-icon">
        <svg viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
      </span>
      <span>Historial</span>
    </a>

    <span class="sidebar-section-label">Catálogos</span>

    <a href="/productos" class="sidebar-link <%= currentPath?.startsWith('/productos') ? 'sidebar-link--active' : '' %>">
      <span class="sidebar-link-icon">
        <svg viewBox="0 0 24 24"><path d="M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z"/></svg>
      </span>
      <span>Productos</span>
    </a>

    <a href="/inventario" class="sidebar-link <%= currentPath?.startsWith('/inventario') ? 'sidebar-link--active' : '' %>">
      <span class="sidebar-link-icon">
        <svg viewBox="0 0 24 24"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>
      </span>
      <span>Inventario</span>
    </a>

    <span class="sidebar-section-label">Sistema</span>

    <a href="/reportes" class="sidebar-link <%= currentPath?.startsWith('/reportes') ? 'sidebar-link--active' : '' %>">
      <span class="sidebar-link-icon">
        <svg viewBox="0 0 24 24"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
      </span>
      <span>Reportes</span>
    </a>

    <a href="/admin" class="sidebar-link <%= currentPath?.startsWith('/admin') ? 'sidebar-link--active' : '' %>">
      <span class="sidebar-link-icon">
        <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><path d="M19.07 4.93A10 10 0 115 19.07"/></svg>
      </span>
      <span>Administración</span>
    </a>

  </nav>

  <div class="sidebar-footer">
    <a href="/logout" class="sidebar-logout">
      <svg viewBox="0 0 24 24"><path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
      <span>Cerrar Sesión</span>
    </a>
  </div>

</aside>

<header class="header">
  <div class="header-left">
    <span class="header-page-title" id="headerPageTitle">Inicio</span>
  </div>
  <div class="header-right">

    <div class="header-badge">
      <svg viewBox="0 0 24 24"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
      <span><%= typeof sucursal !== 'undefined' && sucursal ? sucursal : 'Sucursal A' %></span>
    </div>

    <div class="header-badge">
      <svg viewBox="0 0 24 24"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
      <span><%= typeof caja !== 'undefined' && caja ? caja : 'Caja 1' %></span>
    </div>

    <div class="header-avatar" title="<%= typeof usuario !== 'undefined' && usuario ? (usuario.nombre_completo || usuario.nombre_usuario || 'Usuario') : 'Usuario' %>">
      <%= typeof usuario !== 'undefined' && usuario ? (usuario.nombre_completo || usuario.nombre_usuario || 'U').charAt(0).toUpperCase() : 'U' %>
    </div>

  </div>
</header>

<div class="layout">