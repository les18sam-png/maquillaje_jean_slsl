<%- include('../partials/header', { title }) %>

<div class="page-wrapper">

  <nav class="breadcrumb">
    <a href="/venta" class="breadcrumb__link">POS</a>
    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
    <span class="breadcrumb__current">Cierre de Turno</span>
  </nav>

  <!-- Filtro de turno -->
  <div class="card" style="margin-bottom:16px;padding:14px 20px;">
  <div style="display:flex;align-items:flex-end;gap:12px;flex-wrap:wrap;">

    <!-- Paso 1: elegir fecha -->
    <div class="form-group" style="margin:0;flex:1;min-width:140px;">
      <label class="form-label">Fecha</label>
      <input type="date" id="filtro-fecha" class="form-control"
  value="<%= fechaFiltro %>"
  max="<%= new Date().toLocaleDateString('en-CA', { timeZone: 'America/Mexico_City' }) %>"
  onchange="cargarTurnos(this.value)">


    </div>

    <!-- Paso 2: elegir turno (se llena dinámicamente) -->
    <div class="form-group" style="margin:0;flex:2;min-width:200px;">
      <label class="form-label">Turno</label>
      

    <select id="filtro-turno" class="form-control" onchange="verTurno()">
  <% if (turnosDelDia.length === 0) { %>
    <option value="">Sin turnos en esta fecha</option>
  <% } else { %>
    <% turnosDelDia.forEach(t => {
      const hora = new Date(t.inicio.includes('Z') ? t.inicio : t.inicio + 'Z')
        .toLocaleTimeString('es-MX', {hour:'2-digit', minute:'2-digit'});
    %>
      <option value="<%= t.id %>" data-inicio="<%= t.inicio %>" <%= t.id === turnoSeleccionado ? 'selected' : '' %>>
        <%= hora %> — <%= t.estado === 'abierto' ? '🟢 Abierto' : '⚫ Cerrado' %>
      </option>
    <% }) %>
  <% } %>
</select>


    </div>

    <a href="/turnos/cierre" class="btn btn-ghost" style="flex-shrink:0;">Turno actual</a>
  </div>
</div>

<script>
  async function cargarTurnos(fecha) {
    try {
      const resp = await fetch(`/turnos/lista?fecha=${fecha}&caja_id=<%= typeof turno !== 'undefined' ? turno.caja_id : '' %>`);
      const data = await resp.json();
      const sel  = document.getElementById('filtro-turno');
      const turnos = data.items || [];

      if (turnos.length === 0) {
        sel.innerHTML = '<option value="">Sin turnos en esta fecha</option>';
        return;
      }

      sel.innerHTML = turnos.map(t => {
  const hora = new Date(t.inicio.includes('Z') ? t.inicio : t.inicio + 'Z')
    .toLocaleTimeString('es-MX', {hour:'2-digit', minute:'2-digit'});
  const estado = t.estado === 'abierto' ? '🟢 Abierto' : '⚫ Cerrado';
  return `<option value="${t.id}" data-inicio="${t.inicio}">${hora} — ${estado}</option>`;
}).join('');

      verTurno();
    } catch (err) {
      console.error('Error cargando turnos:', err);
    }
  }

  function verTurno() {
  const select   = document.getElementById('filtro-turno');
  const turno_id = select.value;
  if (!turno_id) return;

  // La fecha del filtro debe coincidir con la fecha REAL del turno
  // elegido (no con lo que quedó puesto en el campo Fecha) — si no,
  // el backend filtra por un día distinto al del turno seleccionado
  // y la lista "se rompe".
  const inicioRaw = select.options[select.selectedIndex]?.dataset.inicio;
  let fecha = document.getElementById('filtro-fecha').value;
  if (inicioRaw) {
    const inicioIso = inicioRaw.includes('Z') ? inicioRaw : inicioRaw + 'Z';
    fecha = new Date(inicioIso).toLocaleDateString('en-CA', { timeZone: 'America/Mexico_City' });
  }

  window.location.href = `/turnos/cierre?turno_id=${turno_id}&fecha=${fecha}`;
}
</script>
  <!-- Encabezado -->
  <div class="page-header">
    <div class="page-header__left">
      <h1 class="page-title">Cierre de Turno</h1>
      <span class="page-subtitle">Resumen y cierre de tu turno actual</span>
    </div>
    <div class="page-header__right">
      <div class="turno-info-badge">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        Turno abierto desde <%= inicio %>
        <span class="turno-duracion">(<%= duracion %>)</span>
      </div>
    </div>
  </div>

  <% if ((query?.error || '') === 'fallo') { %>
    <div class="alert alert--error" style="margin-bottom:16px;">No se pudo cerrar el turno. Intenta de nuevo.</div>
  <% } %>

  <!-- Meta del turno -->
  <div class="turno-meta-grid">
    <div class="turno-meta-item">
      <span class="turno-meta-label">Caja</span>
      <span class="turno-meta-value"><%= turno.cajas?.nombre || '—' %></span>
    </div>
    <div class="turno-meta-item">
      <span class="turno-meta-label">Cajero</span>
      <span class="turno-meta-value"><%= turno.usuarios?.nombre_completo || '—' %></span>
    </div>
    <div class="turno-meta-item">
      <span class="turno-meta-label">Inicio</span>
      <span class="turno-meta-value"><%= inicio %></span>
    </div>
    <div class="turno-meta-item">
      <span class="turno-meta-label">Duración</span>
      <span class="turno-meta-value"><%= duracion %></span>
    </div>
  </div>

  <!-- Stats siempre visibles -->
  <div class="stat-grid" style="margin-bottom:20px;">
    <div class="stat-card">
      <div class="stat-icon burgundy">
        <svg viewBox="0 0 24 24"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6"/></svg>
      </div>
      <div class="stat-info">
        <div class="stat-value">$<%= Number(resumen.totalVentas).toLocaleString('es-MX',{minimumFractionDigits:2}) %></div>
        <div class="stat-label">Total Ventas</div>
      </div>
    </div>
    <div class="stat-card">
      <div class="stat-icon raspberry">
        <svg viewBox="0 0 24 24"><path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/></svg>
      </div>
      <div class="stat-info">
        <div class="stat-value"><%= resumen.totalTickets %></div>
        <div class="stat-label">Tickets</div>
      </div>
    </div>
    <div class="stat-card">
      <div class="stat-icon navy">
        <svg viewBox="0 0 24 24"><rect x="2" y="6" width="20" height="12" rx="2"/><path d="M22 10H2"/></svg>
      </div>
      <div class="stat-info">
        <div class="stat-value">$<%= Number(resumen.totalEfectivo).toLocaleString('es-MX',{minimumFractionDigits:2}) %></div>
        <div class="stat-label">Efectivo</div>
      </div>
    </div>
    <div class="stat-card">
      <div class="stat-icon cherry">
        <svg viewBox="0 0 24 24"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>
      </div>
      <div class="stat-info">
        <div class="stat-value">$<%= Number(resumen.totalTarjeta).toLocaleString('es-MX',{minimumFractionDigits:2}) %></div>
        <div class="stat-label">Tarjeta</div>
      </div>
    </div>
  </div>

  <!-- Desglose completo — siempre visible -->
  <div class="card" style="margin-bottom:20px;">
    <div class="card__header">
      <h3 class="card__title">Desglose por método de pago</h3>
    </div>
    <div style="padding:0 20px 16px;">
      <table class="data-table">
        <thead>
          <tr><th>Método</th><th class="text-right">Monto</th></tr>
        </thead>
        <tbody>
          <% [
            ['efectivo',     'Efectivo',      'efectivo'],
            ['tarjeta',      'Tarjeta',       'tarjeta'],
            ['transferencia','Transferencia', 'transferencia'],
            ['cheque',       'Cheque',        'cheque'],
            
          ].forEach(([key, label, badge]) => { %>
          <tr>
            <td><span class="metodo-badge metodo-badge--<%= badge %>"><%= label %></span></td>
            <td class="text-right fw-medium">
              $<%= Number(resumen['total' + key.charAt(0).toUpperCase() + key.slice(1)] || 0).toLocaleString('es-MX',{minimumFractionDigits:2}) %>
            </td>
          </tr>
          <% }) %>
          <tr style="border-top:2px solid #F2DCDB;">
            <td class="fw-medium" style="color:#6C0820;">Total</td>
            <td class="text-right fw-medium" style="color:#6C0820;font-size:1rem;">
              $<%= Number(resumen.totalVentas).toLocaleString('es-MX',{minimumFractionDigits:2}) %>
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Movimientos de caja del turno -->
<div class="card" style="margin-bottom:20px;">
  <div class="card__header">
    <h3 class="card__title">Movimientos de caja</h3>
  </div>
  <div style="padding:0 20px 16px;">
    <table class="data-table">
      <thead>
        <tr><th>Tipo</th><th>Notas</th><th>Hora</th><th class="text-right">Monto</th></tr>
      </thead>
      <tbody>
        <% if (resumen.detalleMovimientos.length === 0) { %>
          <tr><td colspan="4" style="text-align:center;color:#aaa;padding:16px;">Sin movimientos registrados</td></tr>
        <% } else { %>
          <% resumen.detalleMovimientos.forEach((m, i) => {
            const hora = new Date(m.registrado_en.includes('Z') ? m.registrado_en : m.registrado_en + 'Z')
              .toLocaleTimeString('es-MX', {hour:'2-digit', minute:'2-digit'});
            const esFondo = i === 0 && m.tipo_movimiento === 'entrada';
          %>
          <tr>
            <td>
              <% if (esFondo) { %>
                <span class="badge badge--neutral">Fondo inicial</span>
              <% } else if (m.tipo_movimiento === 'entrada') { %>
                <span class="badge badge--success">Entrada</span>
              <% } else { %>
                <span class="badge badge--error">Salida</span>
              <% } %>
            </td>
            <td style="font-size:.82rem;color:#666;"><%= m.notas || '—' %></td>
            <td style="font-size:.82rem;color:#999;"><%= hora %></td>
            <td class="text-right fw-medium" style="color:<%= m.tipo_movimiento === 'salida' ? '#ef4444' : '#065f46' %>">
              <%= m.tipo_movimiento === 'salida' ? '−' : '+' %>$<%= Number(m.monto).toLocaleString('es-MX',{minimumFractionDigits:2}) %>
            </td>
          </tr>
          <% }) %>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<!-- Efectivo esperado en caja -->
<div class="card" style="margin-bottom:20px;">
    <div class="card__header">
      <h3 class="card__title">Efectivo esperado en caja</h3>
    </div>
    <div style="padding:16px 20px;">
      <table class="data-table">
        <tbody>
          <tr>
            <td style="color:#666;">Fondo inicial</td>
            <td class="text-right">$<%= Number(resumen.fondoInicial).toLocaleString('es-MX',{minimumFractionDigits:2}) %></td>
          </tr>
          <tr>
            <td style="color:#666;">Ventas en efectivo</td>
            <td class="text-right">+$<%= Number(resumen.totalEfectivo).toLocaleString('es-MX',{minimumFractionDigits:2}) %></td>
          </tr>
          <tr>
            <td style="color:#666;">Entradas manuales</td>
            <td class="text-right">+$<%= Number(resumen.entradasManual).toLocaleString('es-MX',{minimumFractionDigits:2}) %></td>
          </tr>
          <tr>
            <td style="color:#666;">Salidas manuales</td>
            <td class="text-right" style="color:#ef4444;">−$<%= Number(resumen.salidasTotal).toLocaleString('es-MX',{minimumFractionDigits:2}) %></td>
          </tr>
          <tr style="border-top:2px solid #F2DCDB;">
            <td class="fw-medium" style="color:#6C0820;font-size:1rem;">Total esperado en caja</td>
            <td class="text-right fw-medium" style="color:#6C0820;font-size:1.1rem;">
              $<%= Number(resumen.efectivoEsperado).toLocaleString('es-MX',{minimumFractionDigits:2}) %>
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

<!-- Confirmar cierre -->
  <div class="turno-form-wrap">
    <form method="POST" action="/turnos/cierre" class="form-card" id="form-cierre-turno">
      <input type="hidden" name="turno_id" value="<%= turno.id %>">
      <div class="form-section">
        <h2 class="form-section__title">Confirmar cierre</h2>
        <div class="cierre-resumen-total">
          <span>Total del turno</span>
          <strong>$<%= Number(resumen.totalVentas).toLocaleString('es-MX',{minimumFractionDigits:2}) %></strong>
        </div>
      </div>
      <div class="form-footer">
        <a href="/venta" class="btn btn-ghost">Seguir vendiendo</a>
        <button type="submit" class="btn btn-danger btn-lg">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="8" y1="12" x2="16" y2="12"/></svg>
          Cerrar Turno
        </button>
      </div>
    </form>
  </div>

</div>

<!-- Overlay de respaldo automático al cerrar turno -->
<div id="cierre-overlay" style="display:none; position:fixed; inset:0; background:rgba(74,5,23,.75); backdrop-filter:blur(3px); z-index:9999; align-items:center; justify-content:center;">
  <div style="background:#fff; border-radius:16px; padding:32px 36px; text-align:center; box-shadow:0 20px 60px rgba(0,0,0,.35); max-width:320px;">
    <div style="width:40px; height:40px; margin:0 auto 16px; border:3px solid #F2DCDB; border-top-color:#6C0820; border-radius:50%; animation:cierre-spin .7s linear infinite;"></div>
    <p style="font-family:'Playfair Display',serif; font-size:1.05rem; color:#6C0820; font-weight:700; margin:0 0 4px;">Cerrando turno…</p>
    <p style="font-size:.82rem; color:#999; margin:0;">Generando respaldo de seguridad</p>
  </div>
</div>

<style>
@keyframes cierre-spin { to { transform: rotate(360deg); } }
</style>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const form    = document.getElementById('form-cierre-turno');
  const overlay = document.getElementById('cierre-overlay');
  if (!form) return;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!confirm('¿Cerrar el turno?\nNo podrás registrar más ventas hasta abrir uno nuevo.')) return;

    overlay.style.display = 'flex';

    try {
      const resp = await fetch('/admin/respaldo/json');
      const esJson = (resp.headers.get('content-type') || '').includes('application/json');

      // Solo se descarga si el usuario tiene perm_administrar (si no, el
      // backend regresa 403 y no es JSON de respaldo real).
      if (resp.ok && !resp.redirected && esJson) {
        const blob = await resp.blob();
        const disposition = resp.headers.get('content-disposition') || '';
        const match  = disposition.match(/filename="?([^";]+)"?/);
        const nombre = match ? match[1] : 'respaldo.json';

        const url = window.URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url; a.download = nombre;
        document.body.appendChild(a); a.click(); a.remove();
        window.URL.revokeObjectURL(url);

        await new Promise(r => setTimeout(r, 600));
      }
    } catch (err) {
      console.error('No se pudo generar el respaldo automático:', err);
      // No bloquea el cierre de turno aunque falle
    }

    form.submit();
  });
});
</script>

<%- include('../partials/footer') %>