<%- include('../partials/header', { title }) %>

<div class="page-wrapper">

  <!-- Breadcrumb -->
  <nav class="breadcrumb">
    <span class="breadcrumb__current">Turnos</span>
    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
    <span class="breadcrumb__current">Apertura</span>
  </nav>

  <!-- Encabezado -->
  <div class="page-header">
    <div class="page-header__left">
      <h1 class="page-title">Apertura de Turno</h1>
      <span class="page-subtitle">Registra el inicio de tu turno de trabajo</span>
    </div>
  </div>

  <!-- Alerta turno ya abierto -->
  <% const errorParam = (typeof query !== 'undefined' ? query?.error : null) || ''; %>
  <% if (turnoAbierto) { %>
    <div class="alert alert--warning">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
      Ya hay un turno abierto en <strong><%= turnoAbierto.cajas?.nombre || 'una caja' %></strong>.
      ¿Quieres <a href="/turnos/cierre" class="link">ir al cierre</a>?
    </div>
  <% } %>

  <% if (errorParam === 'ya-abierto') { %>
    <div class="alert alert--error">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
      Esa caja ya tiene un turno abierto.
    </div>
  <% } %>

  <!-- Toast turno cerrado -->
  <% const toastParam = (typeof query !== 'undefined' ? query?.toast : null) || ''; %>
  <% if (toastParam === 'cerrado') { %>
    <div class="alert alert--success">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
      Turno cerrado correctamente.
    </div>
  <% } %>

  <!-- Formulario apertura -->
  <div class="turno-form-wrap">
    <form method="POST" action="/turnos/apertura" class="form-card" id="form-apertura">

      <div class="form-section">
        <h2 class="form-section__title">Datos del turno</h2>

        <!-- Fecha y hora -->
        <div class="form-group form-group--full">
          <label class="form-label">Fecha y hora de apertura</label>
          <div class="turno-datetime">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            <span id="fecha-hora-display"></span>
          </div>
        </div>

        <!-- Caja + Fondo inicial -->
        <div class="form-row">
          <div class="form-group">
            <label class="form-label" for="caja_id">
              Caja <span class="required">*</span>
            </label>
            <% if (cajas.length === 0) { %>
              <div class="alert alert--warning" style="margin:0">No hay cajas activas configuradas.</div>
            <% } else { %>
              <select name="caja_id" id="caja_id" class="form-control" required>
                <option value="">Selecciona una caja…</option>
                <% cajas.forEach(c => { %>
                  <option value="<%= c.id %>"><%= c.nombre %></option>
                <% }) %>
              </select>
            <% } %>
          </div>

          <div class="form-group">
            <label class="form-label" for="fondo_inicial">
              Fondo inicial en efectivo
            </label>
            <div class="input-money-wrap">
              <span class="input-money-prefix">$</span>
              <input
                type="number"
                id="fondo_inicial"
                name="fondo_inicial"
                class="form-control form-control--money"
                placeholder="0.00"
                min="0"
                step="0.01"
                value="0"
              >
            </div>
            <span class="form-hint">Efectivo con que inicia la caja</span>
          </div>
        </div>

        <!-- Cajero -->
        <div class="form-group form-group--full">
          <label class="form-label">Cajero</label>
          <input type="text" class="form-control" value="Usuario (temporal)" disabled>
          <span class="form-hint">Se asignará automáticamente al implementar login</span>
        </div>

      </div>

      <div class="form-footer">
        <button type="submit" class="btn btn-primary btn-lg" <%= cajas.length === 0 ? 'disabled' : '' %>>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          Abrir Turno
        </button>
      </div>

    </form>
  </div>

</div>

<script>
  function actualizarReloj() {
    const el = document.getElementById('fecha-hora-display');
    if (el) {
      el.textContent = new Date().toLocaleString('es-MX', {
        weekday: 'long', day: '2-digit', month: 'long',
        year: 'numeric', hour: '2-digit', minute: '2-digit', second: '2-digit'
      });
    }
  }
  actualizarReloj();
  setInterval(actualizarReloj, 1000);
</script>

<%- include('../partials/footer') %>