<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<title>Ventas del día — SmartVenta</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@600;700&display=swap" rel="stylesheet">
<style>
  *,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}
  :root{
    --burgundy:#6C0820; --burgundy-dark:#4A0517;
    --pink-light:#FCE4EE; --pink-border:#F2DCDB;
    --navy:#3D5D91; --text:#1a1a2e; --muted:#888; --bg:#FAF5F5;
    --verde:#065f46; --rojo:#c0392b;
  }
  html,body{background:var(--bg);font-family:'DM Sans',sans-serif;color:var(--text);}
  .vd-shell{max-width:480px;margin:0 auto;min-height:100vh;}
  .vd-top{
    background:linear-gradient(160deg,var(--burgundy),var(--burgundy-dark));
    padding:calc(env(safe-area-inset-top) + 16px) 18px 16px;color:#fff;
    display:flex;align-items:center;gap:10px;
  }
  .vd-back{background:rgba(255,255,255,.14);border:1px solid rgba(255,255,255,.25);color:#fff;border-radius:8px;padding:7px 9px;cursor:pointer;display:flex;}
  .vd-titulo{font-family:'Playfair Display',serif;font-size:1.05rem;font-weight:700;}
  .vd-sub{font-size:.68rem;color:rgba(255,255,255,.6);}
  .vd-body{padding:16px 18px 32px;}
  .vd-resumen{display:flex;justify-content:space-between;background:#fff;border:1px solid var(--pink-border);border-radius:12px;padding:12px 14px;margin-bottom:14px;font-size:.82rem;}
  .vd-resumen b{color:var(--burgundy);font-family:'Playfair Display',serif;}
  .vd-fila{
    background:#fff;border:1px solid var(--pink-border);border-radius:12px;
    padding:12px 14px;margin-bottom:8px;display:flex;justify-content:space-between;
    align-items:center;cursor:pointer;transition:background .12s;
  }
  .vd-fila:active{background:var(--pink-light);}
  .vd-fila__folio{font-size:.72rem;color:var(--muted);}
  .vd-fila__hora{font-size:.78rem;color:var(--text);font-weight:600;}
  .vd-badge-metodo{font-size:.65rem;font-weight:700;padding:2px 8px;border-radius:10px;background:var(--pink-light);color:var(--burgundy);text-transform:capitalize;display:inline-block;margin-top:3px;}
  .vd-fila__total{font-family:'Playfair Display',serif;font-weight:700;color:var(--burgundy);font-size:1rem;}
  .vd-vacio{text-align:center;color:#bbb;font-size:.85rem;padding:40px 10px;}

  /* Modal flotante de detalle */
  .vd-modal-overlay{position:fixed;inset:0;background:rgba(74,5,23,.5);backdrop-filter:blur(3px);display:none;align-items:flex-end;z-index:100;}
  .vd-modal-overlay.activo{display:flex;}
  .vd-modal{
    background:#fff;width:100%;max-width:480px;margin:0 auto;
    border-radius:20px 20px 0 0;max-height:75vh;display:flex;flex-direction:column;
    padding-bottom:env(safe-area-inset-bottom);
  }
  .vd-modal__handle{width:36px;height:4px;background:var(--pink-border);border-radius:2px;margin:10px auto;}
  .vd-modal__header{padding:0 18px 12px;border-bottom:1px solid var(--pink-border);}
  .vd-modal__titulo{font-family:'Playfair Display',serif;font-weight:700;color:var(--burgundy);}
  .vd-modal__sub{font-size:.75rem;color:var(--muted);margin-top:2px;}
  .vd-modal__body{overflow-y:auto;padding:10px 18px 18px;}
  .vd-articulo{display:flex;justify-content:space-between;padding:9px 0;border-bottom:1px solid #f5eeee;font-size:.82rem;}
  .vd-articulo:last-child{border-bottom:none;}
  .vd-articulo__cant{color:var(--muted);font-size:.72rem;}
  .vd-articulo__precio{font-weight:600;color:var(--text);}
  .vd-loading{text-align:center;color:#bbb;font-size:.82rem;padding:20px;}
</style>
</head>
<body>

<div class="vd-shell">
  <div class="vd-top">
    <button class="vd-back" onclick="history.back()">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2"><polyline points="15 18 9 12 15 6"/></svg>
    </button>
    <div>
      <div class="vd-titulo">Ventas del día</div>
      <div class="vd-sub" id="vd-fecha-label">Cargando…</div>
    </div>
  </div>

  <div class="vd-body">
    <div class="vd-resumen">
      <span>Total del día: <b id="vd-total">$—</b></span>
      <span id="vd-cantidad">— ventas</span>
    </div>
    <div id="vd-lista"><div class="vd-loading">Cargando ventas…</div></div>
  </div>
</div>

<!-- Modal flotante -->
<div class="vd-modal-overlay" id="vd-modal-overlay" onclick="if(event.target===this) cerrarModal()">
  <div class="vd-modal">
    <div class="vd-modal__handle"></div>
    <div class="vd-modal__header">
      <div class="vd-modal__titulo" id="vd-modal-folio">Ticket</div>
      <div class="vd-modal__sub" id="vd-modal-meta"></div>
    </div>
    <div class="vd-modal__body" id="vd-modal-body">
      <div class="vd-loading">Cargando…</div>
    </div>
  </div>
</div>

<script>
  const fmt = n => '$' + Number(n || 0).toLocaleString('es-MX', { minimumFractionDigits: 2 });
  const params = new URLSearchParams(window.location.search);
  const fecha = params.get('fecha') || new Date().toISOString().slice(0,10);
  const sucursalId = params.get('sucursal_id') || '';

  async function cargar() {
    document.getElementById('vd-fecha-label').textContent =
      new Date(fecha + 'T12:00:00').toLocaleDateString('es-MX', { weekday:'long', day:'numeric', month:'long' });

    const qp = new URLSearchParams({ fecha });
    if (sucursalId) qp.append('sucursal_id', sucursalId);

    try {
      const resp = await fetch(`/dashboard-dueno/data/ventas-dia?${qp}`);
      if (!resp.ok) throw new Error();
      const data = await resp.json();

      const total = data.items.reduce((s, v) => s + Number(v.total), 0);
      document.getElementById('vd-total').textContent = fmt(total);
      document.getElementById('vd-cantidad').textContent = `${data.total} venta${data.total === 1 ? '' : 's'}`;

      const lista = document.getElementById('vd-lista');
      if (!data.items.length) {
        lista.innerHTML = '<div class="vd-vacio">No hay ventas registradas este día.</div>';
        return;
      }
      lista.innerHTML = data.items.map(v => `
        <div class="vd-fila" onclick="abrirDetalle('${v.id}', ${v.folio}, '${v.metodo_pago_principal}', '${fmt(v.total)}', '${new Date(v.creado_en+'Z').toLocaleTimeString('es-MX',{hour:'2-digit',minute:'2-digit',timeZone:'America/Mexico_City'})}')">
          <div>
            <div class="vd-fila__hora">${new Date(v.creado_en + 'Z').toLocaleTimeString('es-MX', { hour:'2-digit', minute:'2-digit', timeZone:'America/Mexico_City' })}</div>
            <div class="vd-fila__folio">Folio #${v.folio}${v.sucursal_nombre ? ' · ' + v.sucursal_nombre : ''}</div>
            <span class="vd-badge-metodo">${v.metodo_pago_principal}</span>
          </div>
          <div class="vd-fila__total">${fmt(v.total)}</div>
        </div>
      `).join('');
    } catch {
      document.getElementById('vd-lista').innerHTML = '<div class="vd-vacio">Error al cargar las ventas.</div>';
    }
  }

  async function abrirDetalle(ventaId, folio, metodo, total, hora) {
    document.getElementById('vd-modal-folio').textContent = `Ticket #${folio}`;
    document.getElementById('vd-modal-meta').textContent = `${hora} · ${metodo} · ${total}`;
    document.getElementById('vd-modal-body').innerHTML = '<div class="vd-loading">Cargando…</div>';
    document.getElementById('vd-modal-overlay').classList.add('activo');

    try {
      const resp = await fetch(`/dashboard-dueno/data/venta/${ventaId}`);
      if (!resp.ok) throw new Error();
      const data = await resp.json();
      document.getElementById('vd-modal-body').innerHTML = data.articulos.map(a => `
        <div class="vd-articulo">
          <div>
            <div>${a.nombre}</div>
            <div class="vd-articulo__cant">x${a.cantidad}${a.cantidad_devuelta > 0 ? ` · ${a.cantidad_devuelta} devuelto(s)` : ''}</div>
          </div>
          <div class="vd-articulo__precio">${fmt(a.precio_unitario * a.cantidad - a.descuento)}</div>
        </div>
      `).join('');
    } catch {
      document.getElementById('vd-modal-body').innerHTML = '<div class="vd-loading">Error al cargar el detalle.</div>';
    }
  }

  function cerrarModal() {
    document.getElementById('vd-modal-overlay').classList.remove('activo');
  }

  cargar();
</script>

</body>
</html>