<%
  // Normaliza un timestamp de Supabase (sin zona horaria, pero guardado
  // en UTC) a un Date correcto, igual que en utils/impresora.js.
  function normalizarFecha(valor) {
    if (!valor) return new Date();
    const tieneZona = /Z$|[+-]\d{2}:\d{2}$/.test(valor);
    return new Date(tieneZona ? valor : `${valor}Z`);
  }
%>
<%- include('../partials/header') %>

<main class="contenido">

  <div class="page-header flex-between">
    <div>
      <h1 class="page-title">Kardex de Inventario</h1>
      <p class="page-subtitle">Historial de movimientos por producto</p>
    </div>
    <a href="/inventario" class="btn btn-ghost">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
      Volver a Inventario
    </a>
  </div>

  <% if (typeof error !== 'undefined' && error) { %>
    <div class="alert alert--error" style="margin-bottom:1.5rem;"><%= error %></div>
  <% } %>

  <!-- BUSCADOR DE PRODUCTO -->
  <div class="card">
    <div class="card-titulo">Seleccionar Producto</div>
    <div class="form-group form-group-buscador">
      <label>Busca por código o descripción</label>
      <div class="buscar-wrap">
        <input type="text" id="buscarProducto" placeholder="Escribe para buscar..."
          value="<%= productoSel ? productoSel.descripcion : '' %>" autocomplete="off">
        <input type="hidden" id="productoIdHidden" value="<%= producto_id %>">
        <div id="sugerencias" class="sugerencias-wrap"></div>
      </div>
    </div>
  </div>

  <% if (productoSel) { %>
  <!-- INFO DEL PRODUCTO -->
  <div class="card kardex-info-card">
    <div class="kardex-info-grid">
      <div class="kardex-info-item">
        <% if (productoSel.ruta_imagen) { %>
          <img src="/uploads/productos/<%= productoSel.ruta_imagen %>" class="kardex-img">
        <% } else { %>
          <div class="kardex-img-placeholder">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" opacity="0.3"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
          </div>
        <% } %>
      </div>
      <div>
        <div class="kardex-prod-nombre"><%= productoSel.descripcion %></div>
        <div class="kardex-prod-meta">
          <span><%= productoSel.codigo_barras || 'Sin código' %></span>
          <span><%= productoSel.categoria_nombre %></span>
        </div>
      </div>
      <div class="kardex-stat">
        <span class="kardex-stat-valor <%= productoSel.stock_actual <= productoSel.inventario_minimo ? 'stock-bajo' : 'stock-ok' %>">
          <%= productoSel.stock_actual %>
        </span>
        <span class="kardex-stat-label">Stock actual</span>
      </div>
      <div class="kardex-stat">
        <span class="kardex-stat-valor text-muted"><%= productoSel.inventario_minimo %></span>
        <span class="kardex-stat-label">Stock mínimo</span>
      </div>
      <div class="kardex-stat">
        <span class="kardex-stat-valor" style="color:var(--burgundy);">$<%= parseFloat(productoSel.precio_venta).toFixed(2) %></span>
        <span class="kardex-stat-label">Precio venta</span>
      </div>
    </div>
  </div>

  <!-- FILTROS -->
  <div class="card">
    <div class="card-titulo">Filtrar movimientos</div>
    <form method="GET" action="/inventario/kardex" class="kardex-filtros">
      <input type="hidden" name="producto_id" value="<%= producto_id %>">

      <div class="form-group">
        <label>Desde</label>
        <input type="date" name="fecha_desde" value="<%= filtros.fecha_desde %>">
      </div>
      <div class="form-group">
        <label>Hasta</label>
        <input type="date" name="fecha_hasta" value="<%= filtros.fecha_hasta %>">
      </div>
      <div class="form-group">
        <label>Tipo</label>
        <select name="tipo_movimiento">
          <option value="">Todos</option>
          <option value="entrada_mercancia" <%= filtros.tipo_movimiento === 'entrada_mercancia' ? 'selected' : '' %>>Entrada mercancía</option>
          <option value="ajuste_inventario" <%= filtros.tipo_movimiento === 'ajuste_inventario' ? 'selected' : '' %>>Ajuste inventario</option>
          <option value="venta" <%= filtros.tipo_movimiento === 'venta' ? 'selected' : '' %>>Venta</option>
          <option value="devolucion" <%= filtros.tipo_movimiento === 'devolucion' ? 'selected' : '' %>>Devolución</option>
          <option value="cancelacion" <%= filtros.tipo_movimiento === 'cancelacion' ? 'selected' : '' %>>Cancelación</option>
        </select>
      </div>
      <div class="form-group">
        <label>Caja</label>
        <select name="caja_id">
          <option value="">Todas</option>
          <% cajas.forEach(c => { %>
            <option value="<%= c.id %>" <%= filtros.caja_id === c.id ? 'selected' : '' %>><%= c.nombre %></option>
          <% }) %>
        </select>
      </div>
      <% if (usuarios.length > 0) { %>
      <div class="form-group">
        <label>Usuario</label>
        <select name="usuario_id">
          <option value="">Todos</option>
          <% usuarios.forEach(u => { %>
            <option value="<%= u.id %>" <%= filtros.usuario_id === u.id ? 'selected' : '' %>><%= u.nombre_completo %></option>
          <% }) %>
        </select>
      </div>
      <% } %>

      <div class="form-group kardex-filtros-btns">
        <button type="submit" class="btn btn-primary">Filtrar</button>
        <a href="/inventario/kardex?producto_id=<%= producto_id %>" class="btn btn-ghost">Limpiar</a>
      </div>
    </form>
  </div>

  <!-- TABLA -->
  <div class="card">
    <div class="card-titulo">
      Movimientos
      <span class="badge-count"><%= movimientos.length %></span>
    </div>
    <div class="tabla-wrap">
      <table class="tabla">
        <thead>
          <tr>
            <th>Fecha y hora</th>
            <th>Tipo</th>
            <th>Usuario</th>
            <th>Caja</th>
            <th>Entrada</th>
            <th>Salida</th>
            <th>Existencia</th>
            <th>Notas</th>
          </tr>
        </thead>
        <tbody>
          <% if (movimientos.length === 0) { %>
            <tr>
              <td colspan="8" class="text-center text-muted" style="padding:2rem;">
                Sin movimientos registrados
              </td>
            </tr>
          <% } else { %>
            <% movimientos.forEach(m => { %>
              <tr>
                <td class="text-muted" style="white-space:nowrap;">
                  <%= normalizarFecha(m.fecha_hora).toLocaleString('es-MX', { timeZone: 'America/Mexico_City' }) %>
                </td>
                <td><span class="tipo-badge tipo-<%= m.tipo_movimiento %>"><%= m.tipo_movimiento.replace(/_/g, ' ') %></span></td>
                <td class="text-muted" style="font-size:.82rem;"><%= m.usuario_nombre || '—' %></td>
                <td class="text-muted" style="font-size:.82rem;"><%= m.caja_nombre || '—' %></td>
                <td>
                  <% if (m.cantidad_entrada > 0) { %>
                    <span class="mov-entrada">+<%= m.cantidad_entrada %></span>
                  <% } else { %>
                    <span class="text-muted">—</span>
                  <% } %>
                </td>
                <td>
                  <% if (m.cantidad_salida > 0) { %>
                    <span class="mov-salida">-<%= m.cantidad_salida %></span>
                  <% } else { %>
                    <span class="text-muted">—</span>
                  <% } %>
                </td>
                <td><strong><%= m.existencia_resultante %></strong></td>
                <td class="text-muted" style="font-size:.82rem;"><%= m.notas || '—' %></td>
              </tr>
            <% }) %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
  <% } %>

</main>

<style>
   .buscar-wrap { position: relative; }
  .card:has(.buscar-wrap) { overflow: visible; position: relative; z-index: 50; }
  .sugerencias-lista { z-index: 2000; }
  .sugerencias-wrap { position: relative; }
  .sugerencias-lista { position: absolute; top: calc(100% + 4px); left: 0; right: 0; background: white; border: 1px solid #ddd; border-radius: 8px; box-shadow: 0 4px 16px rgba(0,0,0,.15); z-index: 1000; max-height: 220px; overflow-y: auto; }
  .sugerencia-item { padding: .5rem .8rem; cursor: pointer; font-size: .875rem; border-bottom: 1px solid #f5f5f5; display: flex; justify-content: space-between; align-items: center; gap: .6rem; }
  .sugerencia-img { width: 36px; height: 36px; object-fit: cover; border-radius: 6px; border: 1px solid #eee; flex-shrink: 0; }
  .sugerencia-img-placeholder { background: #f5f5f5; display: flex; align-items: center; justify-content: center; }
  .sugerencia-texto { min-width: 0; flex: 1; }
  .sugerencia-item:hover { background: #fff8f9; }
  .sugerencia-item:last-child { border-bottom: none; }
  .sugerencia-codigo { font-size: .75rem; color: #999; font-family: monospace; }
  .sugerencia-stock { font-size: .75rem; font-weight: 700; color: var(--burgundy); }

  .kardex-info-card { padding: 1.25rem; }
  .kardex-info-grid { display: flex; align-items: center; gap: 1.5rem; flex-wrap: wrap; }
  .kardex-img { width: 60px; height: 60px; object-fit: cover; border-radius: 10px; border: 1px solid #eee; }
  .kardex-img-placeholder { width: 60px; height: 60px; background: #f5f5f5; border-radius: 10px; display: flex; align-items: center; justify-content: center; }
  .kardex-prod-nombre { font-weight: 700; font-size: 1.05rem; color: var(--burgundy); }
  .kardex-prod-meta { display: flex; gap: .75rem; font-size: .8rem; color: #999; margin-top: .2rem; }
  .kardex-stat { display: flex; flex-direction: column; align-items: center; min-width: 80px; }
  .kardex-stat-valor { font-size: 1.4rem; font-weight: 700; }
  .kardex-stat-label { font-size: .72rem; color: #999; }
  .stock-ok { color: #2d7a2d; }
  .stock-bajo { color: #c0392b; }

  .badge-count { display: inline-flex; align-items: center; justify-content: center; background: var(--burgundy); color: white; font-size: .72rem; font-weight: 700; width: 22px; height: 22px; border-radius: 50%; margin-left: .5rem; }

  .tipo-badge { font-size: .72rem; padding: 2px 8px; border-radius: 20px; font-weight: 600; text-transform: capitalize; }
  .tipo-entrada_mercancia { background: #e6f9e6; color: #2d7a2d; }
  .tipo-ajuste_inventario { background: #fff3cd; color: #856404; }
  .tipo-venta             { background: #ffeaea; color: #c0392b; }
  .tipo-devolucion        { background: #e8f4fd; color: #1a6fa8; }
  .tipo-cancelacion       { background: #f5f5f5; color: #666; }

  .mov-entrada { color: #2d7a2d; font-weight: 700; }
  .mov-salida  { color: #c0392b; font-weight: 700; }

  .form-group-buscador { display: block !important; }

  .kardex-filtros { display: flex; flex-wrap: wrap; gap: 1rem; align-items: flex-end; }
  .kardex-filtros .form-group { min-width: 150px; }
  .kardex-filtros-btns { display: flex; flex-direction: row; gap: .5rem; align-items: flex-end; }
  .alert--error { background: #fee2e2; color: #991b1b; border: 1px solid #fca5a5; }
</style>

<script>
(function() {
  const inputBuscar = document.getElementById('buscarProducto');
  const contenedor  = document.getElementById('sugerencias');
  let timer;
  function pareceCodigoBarras(texto) { return !texto.includes(' ') && texto.length >= 6; }

  inputBuscar.addEventListener('input', function() {
    clearTimeout(timer);
    const q = this.value.trim();
    if (q.length < 2) { contenedor.innerHTML = ''; return; }
    timer = setTimeout(async () => {
      const res  = await fetch('/inventario/api/buscar?q=' + encodeURIComponent(q));
      const data = await res.json();
      if (!data.length) { contenedor.innerHTML = ''; return; }

      // Coincidencia EXACTA de código de barras → ir directo al kardex
      // de ese producto, sin esperar a que el usuario haga clic
      // (igual que el comportamiento del escáner en el POS).
      if (pareceCodigoBarras(q)) {
        const exacto = data.find(p => p.codigo_barras === q);
        if (exacto) {
          contenedor.innerHTML = '';
          window.location.href = '/inventario/kardex?producto_id=' + exacto.id;
          return;
        }
      }

      const lista = document.createElement('div');
      lista.className = 'sugerencias-lista';
      data.forEach(p => {
        const item = document.createElement('div');
        item.className = 'sugerencia-item';
        const miniatura = p.ruta_imagen
          ? `<img src="/uploads/productos/${p.ruta_imagen}" class="sugerencia-img" alt="">`
          : `<div class="sugerencia-img sugerencia-img-placeholder">
               <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" opacity="0.35">
                 <rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/>
               </svg>
             </div>`;
        item.innerHTML = `
          ${miniatura}
          <div class="sugerencia-texto">
            <div>${p.descripcion}</div>
            <div class="sugerencia-codigo">${p.codigo_barras || 'Sin código'}</div>
          </div>
          <span class="sugerencia-stock">${p.stock_actual} uds</span>`;
        item.addEventListener('click', () => {
          window.location.href = '/inventario/kardex?producto_id=' + p.id;
        });
        lista.appendChild(item);
      });
            
      contenedor.innerHTML = '';
      contenedor.appendChild(lista);
    }, 300);
  });
  

  document.addEventListener('click', e => {
    if (!contenedor.contains(e.target) && e.target !== inputBuscar) {
      contenedor.innerHTML = '';
    }
  });
})();
</script>

<%- include('../partials/footer') %>