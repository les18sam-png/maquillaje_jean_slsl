<%- include('../partials/header', { title }) %>

<div class="page-wrapper">

  <!-- Breadcrumb -->
  <nav class="breadcrumb">
    <a href="/clientes" class="breadcrumb__link">Clientes</a>
    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
    <span class="breadcrumb__current"><%= cliente.nombre %></span>
  </nav>

  <!-- Layout dos columnas -->
  <div class="detalle-layout">

    <!-- COLUMNA IZQUIERDA — Perfil -->
    <aside class="detalle-sidebar">

      <!-- Tarjeta de perfil -->
      <div class="card perfil-card">
        <div class="perfil-card__avatar avatar--xl avatar--<%= cliente.es_mayorista ? 'mayorista' : 'normal' %>">
          <%= cliente.nombre ? cliente.nombre.charAt(0).toUpperCase() : '?' %>
        </div>
        <h2 class="perfil-card__nombre"><%= cliente.nombre %></h2>

        <% if (cliente.es_mayorista) { %>
          <span class="badge badge--mayorista">Mayorista</span>
        <% } else { %>
          <span class="badge badge--normal">Cliente normal</span>
        <% } %>

        <div class="perfil-card__acciones">
          <a href="/clientes/<%= cliente.id %>/editar" class="btn btn-secondary btn-sm">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
            Editar
          </a>
          <form method="POST" action="/clientes/<%= cliente.id %>/eliminar" class="form-inline" onsubmit="return confirmarEliminar()">
            <button type="submit" class="btn btn-danger btn-sm">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/></svg>
              Eliminar
            </button>
          </form>
        </div>
      </div>

      <!-- Tarjeta de contacto -->
      <div class="card info-card">
        <h3 class="info-card__title">Contacto</h3>
        <dl class="info-list">

          <div class="info-list__item">
            <dt>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
              Correo
            </dt>
            <dd>
              <% if (cliente.correo) { %>
                <a href="mailto:<%= cliente.correo %>" class="link"><%= cliente.correo %></a>
              <% } else { %>
                <span class="text-muted">—</span>
              <% } %>
            </dd>
          </div>

          <div class="info-list__item">
            <dt>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.41 2 2 0 0 1 3.6 1.21h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.69a16 16 0 0 0 6.08 6.08l.95-.95a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              Teléfono
            </dt>
            <dd>
              <% if (cliente.telefono) { %>
                <a href="tel:<%= cliente.telefono %>" class="link"><%= cliente.telefono %></a>
              <% } else { %>
                <span class="text-muted">—</span>
              <% } %>
            </dd>
          </div>

          <div class="info-list__item">
            <dt>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
              RFC
            </dt>
            <dd>
              <% if (cliente.rfc) { %>
                <code class="rfc-badge"><%= cliente.rfc %></code>
              <% } else { %>
                <span class="text-muted">—</span>
              <% } %>
            </dd>
          </div>

          <% if (cliente.direccion) { %>
          <div class="info-list__item">
            <dt>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
              Dirección
            </dt>
            <dd class="text-sm"><%= cliente.direccion %></dd>
          </div>
          <% } %>

          <div class="info-list__item">
            <dt>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
              Cliente desde
            </dt>
            <dd><%= new Date(cliente.creado_en).toLocaleDateString('es-MX', { day:'2-digit', month:'long', year:'numeric' }) %></dd>
          </div>

        </dl>
      </div>

      <!-- Notas -->
      <% if (cliente.notas) { %>
      <div class="card info-card">
        <h3 class="info-card__title">Notas</h3>
        <p class="notas-texto"><%= cliente.notas %></p>
      </div>
      <% } %>

    </aside>

    <!-- COLUMNA DERECHA — Estadísticas + Historial -->
    <main class="detalle-main">

      <!-- Estadísticas -->
      <div class="stats-grid">
        <div class="stat-card">
          <div class="stat-card__icon stat-card__icon--purchases">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
          </div>
          <div class="stat-card__body">
            <span class="stat-card__value"><%= totalCompras %></span>
            <span class="stat-card__label">Compras</span>
          </div>
        </div>

        <div class="stat-card">
          <div class="stat-card__icon stat-card__icon--total">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
          </div>
          <div class="stat-card__body">
            <span class="stat-card__value">$<%= totalGastado.toLocaleString('es-MX', {minimumFractionDigits:2, maximumFractionDigits:2}) %></span>
            <span class="stat-card__label">Total gastado</span>
          </div>
        </div>

        <div class="stat-card">
          <div class="stat-card__icon stat-card__icon--ticket">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
          </div>
          <div class="stat-card__body">
            <span class="stat-card__value">$<%= ticketPromedio.toLocaleString('es-MX', {minimumFractionDigits:2, maximumFractionDigits:2}) %></span>
            <span class="stat-card__label">Ticket promedio</span>
          </div>
        </div>
      </div>

      <!-- Historial de compras -->
      <div class="card">
        <div class="card__header">
          <h3 class="card__title">Últimas compras</h3>
        </div>

        <% if (ventas.length === 0) { %>
          <div class="empty-state empty-state--sm">
            <div class="empty-state__icon">
              <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
            </div>
            <p>Este cliente aún no tiene compras registradas.</p>
          </div>
        <% } else { %>
          <div class="table-wrapper">
            <table class="data-table">
              <thead>
                <tr>
                  <th>Folio</th>
                  <th>Fecha</th>
                  <th>Método de pago</th>
                  <th>Estado</th>
                  <th class="text-right">Total</th>
                </tr>
              </thead>
              <tbody>
                <% ventas.forEach(v => { %>
                <tr class="data-table__row" data-href="/historial/<%= v.id %>">
                  <td>
                    <code class="folio-badge">#<%= v.folio || v.id.substring(0,8).toUpperCase() %></code>
                  </td>
                  <td class="text-sm">
                    <%= new Date(v.creado_en).toLocaleDateString('es-MX', { day:'2-digit', month:'short', year:'numeric' }) %>
                    <span class="text-muted text-xs">
                      <%= new Date(v.creado_en).toLocaleTimeString('es-MX', { hour:'2-digit', minute:'2-digit' }) %>
                    </span>
                  </td>
                  <td>
                    <span class="metodo-badge metodo-badge--<%= v.metodo_pago %>">
                      <% if (v.metodo_pago === 'efectivo')      { %>Efectivo<% } %>
                      <% if (v.metodo_pago === 'tarjeta')       { %>Tarjeta<% } %>
                      <% if (v.metodo_pago === 'transferencia') { %>Transferencia<% } %>
                      <% if (v.metodo_pago === 'cheque')        { %>Cheque<% } %>
                      <% if (v.metodo_pago === 'mixto')         { %>Mixto<% } %>
                    </span>
                  </td>
                  <td>
                    <span class="badge badge--<%= v.estado === 'completada' ? 'success' : v.estado === 'cancelada' ? 'danger' : 'warning' %>">
                      <%= v.estado ? v.estado.charAt(0).toUpperCase() + v.estado.slice(1) : '—' %>
                    </span>
                  </td>
                  <td class="text-right fw-medium">
                    $<%= (v.total || 0).toLocaleString('es-MX', {minimumFractionDigits:2, maximumFractionDigits:2}) %>
                  </td>
                </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>
      </div>

    </main>
  </div>
</div>

<!-- Toast -->
<% const toast = (typeof query !== 'undefined' ? query.toast : null) || ''; %>
<% if (toast === 'actualizado') { %>
<div class="toast toast--success" id="toast">Cliente actualizado correctamente.</div>
<% } %>

<script>
  document.querySelectorAll('.data-table__row[data-href]').forEach(row => {
    row.addEventListener('click', () => { window.location.href = row.dataset.href; });
    row.style.cursor = 'pointer';
  });

  function confirmarEliminar() {
    return confirm('¿Eliminar este cliente?\nSe conservará el historial de ventas.\nEsta acción no se puede deshacer.');
  }

  const toastEl = document.getElementById('toast');
  if (toastEl) setTimeout(() => toastEl.classList.add('toast--hidden'), 3500);
</script>

<%- include('../partials/footer') %>