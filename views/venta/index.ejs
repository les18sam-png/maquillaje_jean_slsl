<!-- Modal verificador de precios (RF-01.4) -->
<div id="modal-verificador" style="display:none; position:fixed; inset:0; background:rgba(42,15,26,.65); backdrop-filter:blur(4px); z-index:1500; align-items:center; justify-content:center; padding:20px;">
  <div style="background:#fff; border-radius:18px; width:100%; max-width:520px; max-height:85vh; overflow:hidden; display:flex; flex-direction:column; box-shadow:0 28px 80px rgba(0,0,0,.4);">

    <div style="background:linear-gradient(135deg,#6C0820,#B5294E); padding:18px 22px; display:flex; align-items:center; justify-content:space-between; flex-shrink:0;">
      <div style="font-family:'Playfair Display',serif; font-size:1.1rem; font-weight:700; color:#fff; display:flex; align-items:center; gap:8px;">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 8v4l3 3"/></svg>
        Verificador de Precios
      </div>
      <button onclick="cerrarVerificador()" style="background:rgba(255,255,255,.15); border:none; border-radius:8px; color:#fff; padding:4px 10px; cursor:pointer; font-size:.8rem;">✕ Cerrar</button>
    </div>

    <div style="padding:12px 14px; border-bottom:1px solid #F2DCDB; flex-shrink:0;">
      <div style="display:flex; gap:8px;">
        <div style="position:relative; flex:1;">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="position:absolute; left:10px; top:50%; transform:translateY(-50%); color:#aaa; pointer-events:none;"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          <input type="text" id="ver-buscar" placeholder="Buscar por nombre o escanear código…" autocomplete="off"
            style="width:100%; padding:9px 12px 9px 32px; border:1.5px solid #E0C8C8; border-radius:8px; font-size:.9rem; font-family:'DM Sans',sans-serif; outline:none;">
        </div>
        <select id="ver-categoria" style="padding:9px 10px; border:1.5px solid #E0C8C8; border-radius:8px; font-size:.82rem; font-family:'DM Sans',sans-serif; background:#fff; max-width:150px;">
          <option value="">Todas</option>
          <% categorias.forEach(c => { %>
            <option value="<%= c.id %>"><%= c.nombre %></option>
          <% }) %>
        </select>
