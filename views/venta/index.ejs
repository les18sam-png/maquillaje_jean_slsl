      <button class="cobro-btn cobro-btn--sin-imprimir" onclick="procesarCobro(false)">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
        <div><span class="cobro-btn__kbd">F2</span><span>Cobrar sin imprimir</span></div>
      </button>
      <button class="cobro-btn cobro-btn--cancelar" onclick="cerrarModal()">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        <div><span class="cobro-btn__kbd">ESC</span><span>Cancelar</span></div>
