        </div>
        <div class="cobro-cambio-display" id="cobro-cambio-display" style="display:none">
          <span>Su cambio</span>
          <strong id="cobro-cambio-monto">$0.00</strong>
        </div>
        <div class="cobro-referencia" id="cobro-referencia-wrap" style="display:none">
          <label>Referencia / últimos 4 dígitos</label>
