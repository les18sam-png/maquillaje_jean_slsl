    <div id="ver-resultados" style="flex:1; overflow-y:auto; padding:10px 14px; display:flex; flex-direction:column; gap:6px;">
      <div id="ver-placeholder" style="display:flex; flex-direction:column; align-items:center; justify-content:center; height:200px; color:#ccc; gap:10px; text-align:center;">
        <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <p style="font-size:.85rem; color:#bbb;">Busca un producto o escanea su código de barras</p>
      </div>
    </div>

    <div style="padding:10px 16px; border-top:1px solid #F2DCDB; flex-shrink:0;">
      <span style="font-size:.72rem; color:#bbb;">Solo consulta — no genera venta</span>
    </div>

  </div>
</div>

<div class="pdv-toast" id="pdv-toast"></div>

<script>
/* ════════════════════════════════════════
   CONSTANTES DE SESIÓN
════════════════════════════════════════ */
const PENDIENTES_INICIALES = <%- JSON.stringify(pendientes) %>;
const PERMISOS             = <%- JSON.stringify(permisos) %>;

/* ════════════════════════════════════════
   ESTADO GLOBAL
════════════════════════════════════════ */
let tickets     = [];          // array de tickets abiertos en paralelo
let activeIdx   = -1;          // índice del ticket activo
let selectedRow = -1;          // fila seleccionada en el ticket activo
let metodoCobro = 'efectivo';  // método de pago seleccionado en el modal
let cobrando    = false;       // bandera anti doble cobro
let lastVentaId = localStorage.getItem('smartventa_last_venta') || null;// id de la última venta completada (para reimprimir)
let debounceTimer = null;
let ultimaBusquedaId = 0;
let saveTimer     = null;
let toastTimer    = null;
let tipoMovimientoActual = 'entrada';

/* ════════════════════════════════════════
   TICKETS — INICIALIZACIÓN Y GESTIÓN
════════════════════════════════════════ */
const nuevoLocalId = () => 'local_' + Date.now() + '_' + Math.random().toString(36).slice(2, 8);

function crearTicketVacio() {
  return {
    localId: nuevoLocalId(), ventaId: null,
    clienteId: '', clienteNombre: 'Público general',
    items: [], notas: '', dirty: false,
    _guardando: false, _reguardar: false,
  };
}

function ticketActivo() { return tickets[activeIdx]; }

function inicializarTickets() {
  tickets = PENDIENTES_INICIALES.map(v => ({
    localId: nuevoLocalId(), ventaId: v.id,
    clienteId: v.cliente_id || '', clienteNombre: 'Público general',
    items: (v.venta_articulos || []).map(va => ({
      id: va.producto_id,
      nombre:   va.productos?.descripcion  || 'Producto',
      codigo:   va.productos?.codigo_barras || '',
      imagen:   va.productos?.ruta_imagen   || null,
      precio:   Number(va.precio_unitario),
      mayoreo:  null, promo: null, porcentaje_promo: null, cantidad_minima_promo: null,
      cantidad: va.cantidad, stock: Infinity,
      forzado:  va.uso_precio_mayoreo && v.motivo_mayoreo === 'manual',
    })),
    notas: v.notas || '', dirty: false, _guardando: false, _reguardar: false,
  }));
  if (tickets.length === 0) tickets.push(crearTicketVacio());
  activeIdx = 0;
  renderTabs();
  renderTicket();
}

function marcarDirty() {
  const t = ticketActivo();
  t.dirty = true;
  clearTimeout(saveTimer);
  saveTimer = setTimeout(() => guardarTicketEnServidor(t), 800);
}

/* ════════════════════════════════════════
   PESTAÑAS
════════════════════════════════════════ */
function renderTabs() {
  document.getElementById('pdv-tabs').innerHTML =
    tickets.map((t, idx) => `
      <div class="pdv-tab ${idx === activeIdx ? 'pdv-tab--activa' : ''}" onclick="cambiarTab(${idx})">
        <span>Ticket ${idx + 1}${t.items.length ? ` (${t.items.length})` : ''}</span>
        <span class="pdv-tab__close" onclick="event.stopPropagation(); cerrarTab(${idx})">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
          </svg>
        </span>
      </div>`).join('')
    + `<div class="pdv-tab-nueva" onclick="nuevaTab()" title="Nuevo ticket">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
        </svg>
       </div>`;
}

async function cambiarTab(idx) {
  if (idx === activeIdx) return;
  const actual = ticketActivo();
  if (actual?.dirty) await guardarTicketEnServidor(actual);
  activeIdx = idx; selectedRow = -1;
  renderTabs(); renderTicket();
}

function nuevaTab() { tickets.push(crearTicketVacio()); cambiarTab(tickets.length - 1); }

async function cerrarTab(idx) {
  const t = tickets[idx];
  if (t.ventaId) try { await fetch(`/venta/pendiente/${t.ventaId}`, { method: 'DELETE' }); } catch {}
  tickets.splice(idx, 1);
  if (tickets.length === 0) tickets.push(crearTicketVacio());
  activeIdx = Math.min(activeIdx, tickets.length - 1);
  renderTabs(); renderTicket();
}

/* ════════════════════════════════════════
   GUARDADO DE TICKETS PENDIENTES
════════════════════════════════════════ */
async function guardarTicketEnServidor(t) {
  if (t._guardando) { t._reguardar = true; return; }
  t._guardando = true;
  try {
    if (t.items.length === 0) {
      if (t.ventaId) {
        try { await fetch(`/venta/pendiente/${t.ventaId}`, { method: 'DELETE' }); } catch {}
        t.ventaId = null;
      }
      return;
    }
    const payload = {
      cliente_id: t.clienteId || null,
      notas: t.notas || null,
      articulos: t.items.map(i => ({ producto_id: i.id, cantidad: i.cantidad, forzar_mayoreo: !!i.forzado })),
    };
    if (t.ventaId) {
      await fetch(`/venta/pendiente/${t.ventaId}`, {
        method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload),
      });
    } else {
      const resp = await fetch('/venta/pendiente', {
        method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload),
      });
      const data = await resp.json();
      if (data.ok && data.venta) t.ventaId = data.venta.id;
    }
    t.dirty = false;
  } catch (err) { console.error('Error guardando ticket pendiente:', err); }
  finally {
    t._guardando = false;
    if (t._reguardar) { t._reguardar = false; guardarTicketEnServidor(t); }
  }
}

function aparcarTicketActivo() {
  const t = ticketActivo();
  if (t.items.length === 0) { mostrarMensaje('El ticket está vacío.'); return; }
  guardarTicketEnServidor(t).then(() => { mostrarMensaje('Ticket guardado como pendiente.'); nuevaTab(); });
}

function vaciarTicketActivo() {
  const t = ticketActivo();
  if (t.items.length === 0) return;
  if (!confirm('¿Vaciar todos los productos de este ticket?')) return;
  t.items = []; marcarDirty(); renderTabs(); renderTicket();
}

/* ════════════════════════════════════════
   BÚSQUEDA DE PRODUCTOS
════════════════════════════════════════ */
function pareceCodigoBarras(texto) { return !texto.includes(' ') && texto.length >= 6; }

const inputBusqueda = document.getElementById('pdv-search');
const hintBusqueda  = document.getElementById('pdv-search-hint');
inputBusqueda.addEventListener('focus',  () => hintBusqueda.classList.add('pdv-search-hint--visible'));
inputBusqueda.addEventListener('blur',   () => hintBusqueda.classList.remove('pdv-search-hint--visible'));
inputBusqueda.addEventListener('input',  dispararBusqueda);
inputBusqueda.addEventListener('keydown', e => {
  if (e.key === 'Enter') { e.preventDefault(); clearTimeout(debounceTimer); buscarCatalogo(); }
});

function dispararBusqueda() { clearTimeout(debounceTimer); debounceTimer = setTimeout(buscarCatalogo, 300); }

async function buscarCatalogo() {
  const miBusquedaId = ++ultimaBusquedaId;

  const qCrudo   = document.getElementById('pdv-search').value.trim();
  let   categoria = document.getElementById('filtro-categoria').value;
  const grid     = document.getElementById('catalogo-grid');

  const buscarEnTodas = qCrudo.includes('%');
  const q             = qCrudo.replace(/%/g, '').trim();
  const esCodigo      = pareceCodigoBarras(q);
  if (buscarEnTodas || esCodigo) categoria = '';

  if (!q && !categoria) {
    grid.innerHTML = '<div class="pdv-catalogo__placeholder"><p>Busca un producto por nombre/código o selecciona una categoría.</p></div>';
    return;
  }
  grid.innerHTML = '<div class="pdv-catalogo__placeholder"><p>Buscando…</p></div>';

  try {
    const params = new URLSearchParams();
    if (q)        params.append('q', q);
    if (categoria) params.append('categoria', categoria);
    const resp     = await fetch(`/venta/buscar?${params}`);
    if (!resp.ok) throw new Error();
    const productos = await resp.json();

    // Si mientras esperábamos esta respuesta el usuario ya lanzó una
    // búsqueda más nueva, esta respuesta llegó tarde — la ignoramos.
    if (miBusquedaId !== ultimaBusquedaId) return;

    if (esCodigo) {
      const exacto = productos.find(p => p.codigo_barras === q);
      if (exacto) {
        agregarProducto(exacto);
        document.getElementById('pdv-search').value = '';
        grid.innerHTML = '<div class="pdv-catalogo__placeholder"><p>Busca un producto por nombre/código o selecciona una categoría.</p></div>';
        return;
      }
    }
    renderizarResultados(productos);
  } catch {
    if (miBusquedaId !== ultimaBusquedaId) return;
    grid.innerHTML = '<div class="pdv-catalogo__placeholder"><p>Error al buscar productos.</p></div>';
  }
}

function renderizarResultados(productos) {
  const grid = document.getElementById('catalogo-grid');
  if (!productos.length) { grid.innerHTML = '<div class="pdv-catalogo__placeholder"><p>Sin resultados.</p></div>'; return; }
  grid.innerHTML = productos.map(p => {
    const stock   = p.cantidad_actual ?? 0;
    const agotado = stock <= 0;
    const n       = String(p.nombre).replace(/"/g, '&quot;');
    return `
      <div class="pdv-mini-card ${agotado ? 'pdv-mini-card--agotado' : ''}"
           data-id="${p.id}" data-nombre="${n}" data-codigo="${p.codigo_barras || ''}"
           data-precio="${p.precio_venta}" data-mayoreo="${p.precio_mayoreo || ''}"
           data-precio-promo="${p.precio_promo || ''}" data-porcentaje-promo="${p.porcentaje_promo || ''}"
           data-cantidad-minima-promo="${p.cantidad_minima_promo || ''}"
           data-imagen="${p.ruta_imagen || ''}" data-stock="${stock}" title="${n}">
        <div class="pdv-mini-card__img">
          ${p.ruta_imagen
            ? `<img src="/uploads/productos/${p.ruta_imagen}" alt="${n}" loading="lazy">`
            : `<div class="pdv-mini-card__img-placeholder">
                 <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                   <rect x="3" y="3" width="18" height="18" rx="2"/>
                   <circle cx="8.5" cy="8.5" r="1.5"/>
                   <polyline points="21 15 16 10 5 21"/>
                 </svg>
               </div>`}
          ${agotado ? '<div class="pdv-mini-card__agotado">Agotado</div>' : ''}
        </div>
        <div class="pdv-mini-card__info">
          <p class="pdv-mini-card__nombre">${n}</p>
          <p class="pdv-mini-card__precio">$${Number(p.precio_venta).toLocaleString('es-MX', { minimumFractionDigits: 2 })}</p>
        </div>
      </div>`;
  }).join('');
}

document.getElementById('catalogo-grid').addEventListener('click', e => {
  const card = e.target.closest('.pdv-mini-card');
  if (!card || card.classList.contains('pdv-mini-card--agotado')) return;
  agregarProducto({
    id: card.dataset.id, nombre: card.dataset.nombre,
    codigo_barras: card.dataset.codigo, precio_venta: card.dataset.precio,
    precio_mayoreo: card.dataset.mayoreo, ruta_imagen: card.dataset.imagen,
    cantidad_actual: card.dataset.stock,
    precio_promo: card.dataset.precioPromo,
    porcentaje_promo: card.dataset.porcentajePromo,
    cantidad_minima_promo: card.dataset.cantidadMinimaPromo,
  });
});

/* ════════════════════════════════════════
   VERIFICADOR DE PRECIOS (F9)
════════════════════════════════════════ */
let verDebounce = null;

function abrirVerificador() {
  document.getElementById('modal-verificador').style.display = 'flex';
  const inp = document.getElementById('ver-buscar');
  inp.value = '';
  document.getElementById('ver-resultados').innerHTML =
    document.getElementById('ver-placeholder').outerHTML;
  setTimeout(() => inp.focus(), 100);
  inp.addEventListener('input', _verDisparar);
  document.getElementById('ver-categoria').addEventListener('change', _verDisparar);
}

function cerrarVerificador() {
  document.getElementById('modal-verificador').style.display = 'none';
  document.getElementById('ver-buscar').removeEventListener('input', _verDisparar);
  document.getElementById('ver-categoria').removeEventListener('change', _verDisparar);
}

function _verDisparar() { clearTimeout(verDebounce); verDebounce = setTimeout(_verBuscar, 280); }

async function _verBuscar() {
  const q        = document.getElementById('ver-buscar').value.trim();
  const categoria = document.getElementById('ver-categoria').value;
  const cont     = document.getElementById('ver-resultados');

  if (!q && !categoria) {
    cont.innerHTML = document.getElementById('ver-placeholder')?.outerHTML ||
      '<div style="text-align:center;color:#bbb;padding:40px;font-size:.85rem;">Busca un producto o escanea su código de barras</div>';
    return;
  }
  cont.innerHTML = '<div style="text-align:center;color:#bbb;padding:40px;font-size:.85rem;">Buscando…</div>';

  try {
    const params = new URLSearchParams();
    if (q)        params.append('q', q);
    if (categoria) params.append('categoria', categoria);
    const resp = await fetch(`/venta/buscar?${params}`);
    if (!resp.ok) throw new Error();
    const productos = await resp.json();

    if (!productos.length) {
      cont.innerHTML = '<div style="text-align:center;color:#bbb;padding:40px;font-size:.85rem;">Sin resultados.</div>';
      return;
    }

    cont.innerHTML = productos.map(p => {
      const nombre = String(p.nombre || p.descripcion || '').replace(/</g, '&lt;');
      const img = p.ruta_imagen
        ? `<img src="/uploads/productos/${p.ruta_imagen}" style="width:100%;height:100%;object-fit:cover;" loading="lazy">`
        : `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#C88" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>`;
      const mayoreo = p.precio_mayoreo
        ? `<span style="font-size:.75rem;font-weight:600;color:#B5294E;background:#FCE4EE;padding:2px 8px;border-radius:10px;">Mayoreo $${Number(p.precio_mayoreo).toLocaleString('es-MX',{minimumFractionDigits:2})}</span>`
        : `<span style="font-size:.72rem;color:#ccc;">Sin precio mayoreo</span>`;
      return `
        <div style="display:grid;grid-template-columns:56px 1fr auto;align-items:center;gap:12px;padding:12px;border-radius:10px;border:1.5px solid #F2DCDB;">
          <div style="width:56px;height:56px;border-radius:8px;background:#F2DCDB;overflow:hidden;display:flex;align-items:center;justify-content:center;">${img}</div>
          <div style="min-width:0;">
            <div style="font-size:.88rem;font-weight:600;color:#3D5D91;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">${nombre}</div>
            ${p.codigo_barras ? `<div style="font-size:.7rem;color:#aaa;font-family:monospace;">${p.codigo_barras}</div>` : ''}
          </div>
          <div style="display:flex;flex-direction:column;align-items:flex-end;gap:4px;flex-shrink:0;">
            <span style="font-family:'Playfair Display',serif;font-size:1.15rem;font-weight:700;color:#6C0820;">$${Number(p.precio_venta).toLocaleString('es-MX',{minimumFractionDigits:2})}</span>
            ${mayoreo}
          </div>
        </div>`;
    }).join('');
  } catch {
    cont.innerHTML = '<div style="text-align:center;color:#bbb;padding:40px;font-size:.85rem;">Error al buscar. Intenta de nuevo.</div>';
  }
}

/* ════════════════════════════════════════
   PRODUCTOS DEL TICKET
════════════════════════════════════════ */
function agregarProducto(p) {
  const stock = Number(p.cantidad_actual ?? 0);
  if (stock <= 0) return;
  const t     = ticketActivo();
  const existe = t.items.findIndex(i => i.id === p.id);
  if (existe >= 0) {
    if (t.items[existe].cantidad + 1 > t.items[existe].stock) {
      mostrarMensaje(`Solo hay ${t.items[existe].stock} unidades disponibles de "${t.items[existe].nombre}"`);
      selectedRow = existe;
    } else {
      t.items[existe].cantidad++;
      selectedRow = existe;
    }
  } else {
    t.items.push({
      id: p.id, nombre: p.nombre, codigo: p.codigo_barras || '',
      precio:   parseFloat(p.precio_venta),
      mayoreo:  p.precio_mayoreo           ? parseFloat(p.precio_mayoreo)           : null,
      promo:    p.precio_promo             ? parseFloat(p.precio_promo)             : null,
      porcentaje_promo:      p.porcentaje_promo      ? parseFloat(p.porcentaje_promo)      : null,
      cantidad_minima_promo: p.cantidad_minima_promo ? parseInt(p.cantidad_minima_promo)   : null,
      imagen: p.ruta_imagen, cantidad: 1, stock, forzado: false,
    });
    selectedRow = t.items.length - 1;
  }
  marcarDirty(); renderTabs(); renderTicket();
}

function cambiarQty(idx, delta) {
  const t    = ticketActivo();
  const nueva = t.items[idx].cantidad + delta;
  if (delta > 0 && nueva > t.items[idx].stock) {
    mostrarMensaje(`Solo hay ${t.items[idx].stock} unidades disponibles de "${t.items[idx].nombre}"`);
    return;
  }
  if (nueva <= 0) { eliminarItem(idx); return; }
  t.items[idx].cantidad = nueva;
  marcarDirty(); renderTabs(); renderTicket();
}

function eliminarItem(idx) {
  const t = ticketActivo();
  t.items.splice(idx, 1);
  if (selectedRow >= t.items.length) selectedRow = t.items.length - 1;
  marcarDirty(); renderTabs(); renderTicket();
}

function seleccionarFila(idx) { selectedRow = idx; renderTicket(); }

function toggleForzarMayoreo() {
  if (!PERMISOS.perm_descuentos) { mostrarMensaje('No tienes permiso para forzar precio de mayoreo.'); return; }
  const t = ticketActivo();
  if (selectedRow < 0 || !t.items[selectedRow])  { mostrarMensaje('Selecciona un producto del ticket primero.'); return; }
  if (!t.items[selectedRow].mayoreo)              { mostrarMensaje('Este producto no tiene precio de mayoreo configurado.'); return; }
  t.items[selectedRow].forzado = !t.items[selectedRow].forzado;
  marcarDirty(); renderTicket();
}

/* ════════════════════════════════════════
   CLIENTE
════════════════════════════════════════ */
function onClienteChange() {
  const sel = document.getElementById('pdv-cliente');
  const opt = sel.options[sel.selectedIndex];
  const t   = ticketActivo();
  t.clienteId     = sel.value;
  t.clienteNombre = opt.dataset.nombre || 'Público general';
  marcarDirty(); renderTicket();
}

/* ════════════════════════════════════════
   CÁLCULO DE PRECIOS
════════════════════════════════════════ */
function esMayoristaActual() {
  const sel = document.getElementById('pdv-cliente');
  return sel.options[sel.selectedIndex]?.dataset.mayorista === 'true';
}

function aplicaMayoreoItem(item) {
  if (!item.mayoreo)                return false;
  if (metodoCobro === 'tarjeta')    return false;   // RF-05.3
  if (esMayoristaActual())          return true;    // RF-05.2
  return item.mayoreo * item.cantidad > 350;        // RF-05.1 (por línea)
}

function precioAplicado(item) {
  // Promoción tiene prioridad (RF-09)
  if (item.cantidad_minima_promo != null && item.cantidad >= item.cantidad_minima_promo) {
    if (item.promo != null)     return item.promo;
    if (item.porcentaje_promo)  return item.precio * (1 - item.porcentaje_promo / 100);
  }
  if (item.forzado)            return item.mayoreo;  // F11: override manual
  return aplicaMayoreoItem(item) ? item.mayoreo : item.precio;
}

function motivoPrecio(item) {
  if (item.cantidad_minima_promo != null && item.cantidad >= item.cantidad_minima_promo) {
    if (item.promo != null || item.porcentaje_promo) return 'promo';
  }
  if (item.forzado)            return 'forzado';
  if (aplicaMayoreoItem(item)) return esMayoristaActual() ? 'mayoreo_cliente' : 'mayoreo_monto';
  return 'normal';
}

function etiquetaMotivo(motivo) {
  return {
    promo:           '<span class="tag-promo">PROMOCIÓN</span>',
    forzado:         '<span class="tag-forzado">MAYOREO FORZADO</span>',
    mayoreo_cliente: '<span class="tag-mayoreo">MAYOREO CLIENTE</span>',
    mayoreo_monto:   '<span class="tag-mayoreo">MAYOREO</span>',
  }[motivo] || '';
}

/* ════════════════════════════════════════
   RENDER TICKET
════════════════════════════════════════ */
function renderTicket() {
  const body = document.getElementById('ticket-body');
  const t    = ticketActivo();

  // Actualizar estado del botón F11
  document.getElementById('btn-forzar-mayoreo').classList.toggle('activo', selectedRow >= 0 && !!t.items[selectedRow]?.forzado);

  // Sincronizar selector de cliente con el ticket activo
  const selCliente = document.getElementById('pdv-cliente');
  if (selCliente.value !== t.clienteId) selCliente.value = t.clienteId || '';

  if (t.items.length === 0) {
    body.innerHTML = `
      <div class="pdv-ticket__empty">
        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/>
          <path d="M1 1h4l2.68 13.39a2 2 0 002 1.61h9.72a2 2 0 002-1.61L23 6H6"/>
        </svg>
        <p>Escanea o selecciona un producto</p>
      </div>`;
    document.getElementById('btn-cobrar').disabled = true;
    actualizarTotal();
    return;
  }

  body.innerHTML = t.items.map((item, idx) => {
    const motivo   = motivoPrecio(item);
    const precio   = precioAplicado(item);
    const subtotal = precio * item.cantidad;
    const claseMotivo = motivo === 'promo' ? 'pdv-ticket-row--promo'
                      : motivo !== 'normal' ? 'pdv-ticket-row--mayoreo' : '';
    return `
      <div class="pdv-ticket-row ${idx === selectedRow ? 'pdv-ticket-row--selected' : ''} ${claseMotivo} ${item.sinStock !== undefined ? 'pdv-ticket-row--sin-stock' : ''}"
           onclick="seleccionarFila(${idx})">
        <div class="pdv-ticket-row__codigo">${item.codigo || '—'}</div>
        <div>
          <div class="pdv-ticket-row__nombre">${item.nombre}</div>
          ${etiquetaMotivo(motivo)}
        </div>
        <div class="pdv-ticket-row__qty">
          <button class="pdv-qty-btn" onclick="event.stopPropagation(); cambiarQty(${idx}, -1)">−</button>
          <span class="pdv-qty-num">${item.cantidad}</span>
          <button class="pdv-qty-btn" onclick="event.stopPropagation(); cambiarQty(${idx}, 1)">+</button>
        </div>
        <div class="pdv-ticket-row__precio">$${precio.toLocaleString('es-MX', { minimumFractionDigits: 2 })}</div>
        <div class="pdv-ticket-row__subtotal">$${subtotal.toLocaleString('es-MX', { minimumFractionDigits: 2 })}</div>
        <button class="pdv-ticket-row__del" onclick="event.stopPropagation(); eliminarItem(${idx})" title="Quitar">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
          </svg>
        </button>
      </div>`;
  }).join('');

  document.getElementById('btn-cobrar').disabled = false;
  actualizarTotal();
}

function getTotal() {
  return ticketActivo().items.reduce((s, i) => s + precioAplicado(i) * i.cantidad, 0);
}

function actualizarTotal() {
  document.getElementById('pdv-total').textContent =
    `$${getTotal().toLocaleString('es-MX', { minimumFractionDigits: 2 })}`;
}

/* ════════════════════════════════════════
   MODAL COBRO
════════════════════════════════════════ */
function abrirModalCobro() {
  const t = ticketActivo();
  if (t.items.length === 0) return;

  const total = getTotal();
  document.getElementById('cobro-total').textContent =
    `$${total.toLocaleString('es-MX', { minimumFractionDigits: 2 })}`;
  document.getElementById('cobro-num-articulos').textContent =
    `${t.items.reduce((s, i) => s + i.cantidad, 0)} artículo(s)`;
  document.getElementById('cobro-cliente-label').textContent =
    t.clienteNombre || 'Público general';

  // Limpiar campos del modal
  document.getElementById('cobro-pago-con').value   = total.toFixed(2);
  document.getElementById('cobro-referencia').value = '';
  ['cobro-mix-efectivo', 'cobro-mix-tarjeta', 'cobro-mix-transferencia', 'cobro-mix-cheque']
    .forEach(id => { document.getElementById(id).value = ''; });
  document.getElementById('cobro-restante-monto').textContent =
    `$${total.toLocaleString('es-MX', { minimumFractionDigits: 2 })}`;

  seleccionarMetodoCobro('efectivo');
  document.getElementById('modal-cobro').style.display = 'flex';
  setTimeout(() => document.getElementById('cobro-pago-con').focus(), 100);
}

function seleccionarMetodoCobro(met) {
  metodoCobro = met;

  // Resaltar botón activo
  document.querySelectorAll('.cobro-metodo').forEach(b => b.classList.remove('cobro-metodo--activo'));
  document.getElementById(`cmet-${met}`)?.classList.add('cobro-metodo--activo');

  const esMixto = met === 'mixto';
  document.getElementById('cobro-panel-simple').style.display = esMixto ? 'none'  : 'block';
  document.getElementById('cobro-panel-mixto').style.display  = esMixto ? 'block' : 'none';

  if (!esMixto) {
    document.getElementById('cobro-pago-label').textContent    = met === 'efectivo' ? 'Pagó con' : 'Monto';
    document.getElementById('cobro-cambio-display').style.display  = 'none';
    document.getElementById('cobro-referencia-wrap').style.display =
      ['tarjeta', 'transferencia', 'cheque'].includes(met) ? 'block' : 'none';
    setTimeout(() => document.getElementById('cobro-pago-con').focus(), 50);
  } else {
    actualizarRestante();
  }

  // Si es tarjeta, re-render ticket para mostrar precios sin mayoreo (RF-05.3)
  renderTicket();
}

function actualizarCambioModal() {
  if (metodoCobro !== 'efectivo') return;
  const total    = getTotal();
  const recibido = parseFloat(document.getElementById('cobro-pago-con').value) || 0;
  const display  = document.getElementById('cobro-cambio-display');
  if (recibido > 0) {
    const cambio = recibido - total;
    display.style.display = 'flex';
    document.getElementById('cobro-cambio-monto').textContent =
      `$${Math.max(0, cambio).toLocaleString('es-MX', { minimumFractionDigits: 2 })}`;
    display.classList.toggle('cobro-cambio-display--negativo', cambio < 0);
  } else {
    display.style.display = 'none';
  }
}

function actualizarRestante() {
  const total    = getTotal();
  const ef       = parseFloat(document.getElementById('cobro-mix-efectivo').value)      || 0;
  const tar      = parseFloat(document.getElementById('cobro-mix-tarjeta').value)       || 0;
  const tra      = parseFloat(document.getElementById('cobro-mix-transferencia').value) || 0;
  const che      = parseFloat(document.getElementById('cobro-mix-cheque').value)        || 0;
  const restante = total - ef - tar - tra - che;
  document.getElementById('cobro-restante-monto').textContent =
    `$${Math.max(0, restante).toLocaleString('es-MX', { minimumFractionDigits: 2 })}`;
}

function cerrarModal() {
  document.getElementById('modal-cobro').style.display = 'none';
  // Si se canceló con tarjeta, restaurar precios del ticket
  if (metodoCobro === 'tarjeta') { metodoCobro = 'efectivo'; renderTicket(); }
}

function construirPagos(total) {
  if (metodoCobro === 'mixto') {
    const pagos = [];
    const ef  = parseFloat(document.getElementById('cobro-mix-efectivo').value)      || 0;
    const tar = parseFloat(document.getElementById('cobro-mix-tarjeta').value)       || 0;
    const tra = parseFloat(document.getElementById('cobro-mix-transferencia').value) || 0;
    const che = parseFloat(document.getElementById('cobro-mix-cheque').value)        || 0;
    if (ef)  pagos.push({ metodo: 'efectivo',      monto: ef,  recibido: ef });
    if (tar) pagos.push({ metodo: 'tarjeta',       monto: tar });
    if (tra) pagos.push({ metodo: 'transferencia', monto: tra });
    if (che) pagos.push({ metodo: 'cheque',        monto: che });
    return pagos;
  }
  const monto = parseFloat(document.getElementById('cobro-pago-con').value) || total;
  const pago  = { metodo: metodoCobro, monto };
  if (metodoCobro === 'efectivo') pago.recibido = monto;
  if (['tarjeta', 'transferencia', 'cheque'].includes(metodoCobro)) {
    pago.referencia = document.getElementById('cobro-referencia').value || null;
  }
  return [pago];
}

async function procesarCobro(imprimir = false) {
  if (cobrando) return;
  const t     = ticketActivo();
  const total = getTotal();
  const pagos = construirPagos(total);

  // Validaciones
  if (metodoCobro === 'mixto') {
    const suma = pagos.reduce((s, p) => s + p.monto, 0);
    if (Math.abs(suma - total) > 0.01) {
      mostrarMensaje(`Faltan $${(total - suma).toFixed(2)} por cubrir.`); return;
    }
  } else if (metodoCobro === 'efectivo') {
    const recibido = parseFloat(document.getElementById('cobro-pago-con').value) || 0;
    if (recibido < total) { mostrarMensaje('El monto recibido es menor al total.'); return; }
  }

  cobrando = true;
  try {
    let resp, data;
    if (t.ventaId) {
      resp = await fetch(`/venta/pendiente/${t.ventaId}/cobrar`, {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ pagos }),
      });
    } else {
      resp = await fetch('/venta/cobrar', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          cliente_id: t.clienteId || null,
          articulos:  t.items.map(i => ({ producto_id: i.id, cantidad: i.cantidad, forzar_mayoreo: !!i.forzado })),
          pagos,
        }),
      });
    }
    data = await resp.json();

    if (!resp.ok || !data.ok) {
      const det = data?.detalle;
      if (det?.error === 'stock_insuficiente') {
        const idx = t.items.findIndex(i => i?.id === det.producto_id);
        if (idx >= 0) { selectedRow = idx; t.items[idx].sinStock = det.existencia; renderTicket(); }
        mostrarMensaje(det.mensaje || 'Un producto no tiene stock suficiente.');
      } else {
        mostrarMensaje(data?.error || 'No se pudo cobrar la venta.');
      }
      return;
    }

    const ventaResp = data.venta || data;
    lastVentaId = ventaResp?.id || null;
if (lastVentaId) localStorage.setItem('smartventa_last_venta', lastVentaId);
    const folioTxt  = ventaResp?.folio ?? '';

    // Imprimir si se solicitó (F1)
    if (imprimir && lastVentaId) {
      try {
        const impResp = await fetch(`/impresion/ticket/${lastVentaId}`, { method: 'POST' });
        const impData = await impResp.json();
        mostrarMensaje(impData.ok
          ? `✓ Folio #${folioTxt} — Ticket impreso`
          : `Venta registrada, error al imprimir: ${impData.error}`);
      } catch {
        mostrarMensaje(`Venta registrada (Folio #${folioTxt}), sin conexión con la impresora.`);
      }
    } else {
      mostrarMensaje(`✓ Venta registrada — Folio #${folioTxt}`);
    }

    cerrarModal();
    const idxCerrado = tickets.indexOf(t);
    if (idxCerrado >= 0) tickets.splice(idxCerrado, 1);
    if (tickets.length === 0) tickets.push(crearTicketVacio());
    activeIdx   = Math.min(idxCerrado < 0 ? 0 : idxCerrado, tickets.length - 1);
    selectedRow = -1;
    metodoCobro = 'efectivo';
    renderTabs(); renderTicket();
  } catch (err) {
    mostrarMensaje('Error de conexión al cobrar.');
    console.error(err);
  } finally {
    cobrando = false;
  }
}

function reimprimirUltimo() {
  if (!lastVentaId) { mostrarMensaje('No hay ninguna venta reciente en esta sesión para reimprimir.'); return; }
  fetch(`/impresion/ticket/${lastVentaId}`, { method: 'POST' })
    .then(r => r.json())
    .then(d => mostrarMensaje(d.ok ? 'Ticket reimpreso correctamente.' : 'Error al reimprimir: ' + d.error))
    .catch(() => mostrarMensaje('No se pudo conectar con la impresora.'));
}

/* ════════════════════════════════════════
   MOVIMIENTOS DE CAJA (F7 / F8)
════════════════════════════════════════ */
function abrirModalMovimiento(tipo) {
  tipoMovimientoActual = tipo;
  document.getElementById('modal-movimiento-titulo').textContent =
    tipo === 'entrada' ? 'Entrada de efectivo' : 'Salida de efectivo';
  document.getElementById('movimiento-monto').value = '';
  document.getElementById('movimiento-notas').value = '';
  document.getElementById('modal-movimiento').style.display = 'flex';
}

function cerrarModalMovimiento() { document.getElementById('modal-movimiento').style.display = 'none'; }

async function confirmarMovimiento() {
  const monto = parseFloat(document.getElementById('movimiento-monto').value);
  if (!monto || monto <= 0) { mostrarMensaje('Ingresa un monto válido.'); return; }
  try {
    const resp = await fetch('/venta/movimiento-caja', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        tipo_movimiento: tipoMovimientoActual, monto,
        notas: document.getElementById('movimiento-notas').value || null,
      }),
    });
    const data = await resp.json();
    if (!resp.ok || !data.ok) { mostrarMensaje(data.error || 'No se pudo registrar el movimiento.'); return; }
    mostrarMensaje(`${tipoMovimientoActual === 'entrada' ? 'Entrada' : 'Salida'} registrada correctamente.`);
    cerrarModalMovimiento();
  } catch { mostrarMensaje('Error de conexión.'); }
}

/* ════════════════════════════════════════
   TOAST
════════════════════════════════════════ */
function mostrarMensaje(texto) {
  const toast = document.getElementById('pdv-toast');
  clearTimeout(toastTimer);
  toast.textContent = texto;
  toast.classList.add('pdv-toast--visible');
  toastTimer = setTimeout(() => toast.classList.remove('pdv-toast--visible'), 4000);
}

/* ════════════════════════════════════════
   TECLADO GLOBAL
════════════════════════════════════════ */
document.addEventListener('keydown', e => {
  const activo = document.activeElement;
  if (activo && ['INPUT', 'TEXTAREA', 'SELECT'].includes(activo.tagName)) return;

  const modalCobroAbierto = document.getElementById('modal-cobro').style.display !== 'none';

  // Atajos dentro del modal de cobro
  if (modalCobroAbierto) {
    if      (e.key === 'F1')     { e.preventDefault(); procesarCobro(true);  }
    else if (e.key === 'F2')     { e.preventDefault(); procesarCobro(false); }
    else if (e.key === 'Escape') { e.preventDefault(); cerrarModal(); }
    return;
  }

  // Atajos generales del POS
  const t = ticketActivo();
  if      (e.key === 'F4')  { e.preventDefault(); vaciarTicketActivo(); }
  else if (e.key === 'F6')  { e.preventDefault(); aparcarTicketActivo(); }
  else if (e.key === 'F7')  { e.preventDefault(); abrirModalMovimiento('entrada'); }
  else if (e.key === 'F8')  { e.preventDefault(); abrirModalMovimiento('salida');  }
  else if (e.key === 'F9') { e.preventDefault(); abrirVerificador(); }
  else if (e.key === 'F11') { e.preventDefault(); toggleForzarMayoreo(); }
  else if (e.key === 'F12') { e.preventDefault(); if (!document.getElementById('btn-cobrar').disabled) abrirModalCobro(); }
  else if (t.items.length === 0) return;
  else if (e.key === 'ArrowDown') { e.preventDefault(); selectedRow = Math.min((selectedRow < 0 ? -1 : selectedRow) + 1, t.items.length - 1); renderTicket(); }
  else if (e.key === 'ArrowUp')   { e.preventDefault(); selectedRow = Math.max(selectedRow - 1, 0); renderTicket(); }
  else if (e.key === '+' || e.key === '=') { e.preventDefault(); if (selectedRow >= 0) cambiarQty(selectedRow,  1); }
  else if (e.key === '-' || e.key === '_') { e.preventDefault(); if (selectedRow >= 0) cambiarQty(selectedRow, -1); }
});

/* Init */
inicializarTickets();
</script>

<!-- ══════════════════════════════════════
     OVERLAY APERTURA DE TURNO
     (se muestra si el usuario no tiene turno abierto)
══════════════════════════════════════ -->
<% if (!tieneTurno) { %>
<div id="turno-overlay" style="position:fixed;inset:0;background:rgba(74,5,23,.72);backdrop-filter:blur(3px);z-index:9000;display:flex;align-items:center;justify-content:center;padding:20px;">
  <div style="background:#fff;border-radius:20px;padding:32px 28px;width:100%;max-width:400px;box-shadow:0 28px 80px rgba(0,0,0,.4);">

    <div style="display:flex;align-items:center;gap:10px;margin-bottom:20px;">
      <div style="width:36px;height:36px;background:#6C0820;border-radius:10px;display:flex;align-items:center;justify-content:center;">
        <svg viewBox="0 0 24 24" fill="white" width="18" height="18"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 14H9V8h2v8zm4 0h-2V8h2v8z"/></svg>
      </div>
      <span style="font-family:'Playfair Display',serif;font-size:1.1rem;font-weight:700;color:#6C0820;">SmartVenta</span>
    </div>

    <div id="turno-conectando">
      <h2 style="font-family:'Playfair Display',serif;font-size:1.4rem;color:#1a1a2e;margin:0 0 8px;">Verificando turno…</h2>
      <p style="font-size:.85rem;color:#aaa;margin:0 0 24px;">Detectando caja de esta terminal</p>
      <div style="display:flex;justify-content:center;">
        <div style="width:36px;height:36px;border:3px solid #F2DCDB;border-top-color:#6C0820;border-radius:50%;animation:spin .7s linear infinite;"></div>
      </div>
    </div>

    <div id="turno-formulario" style="display:none;">
      <h2 style="font-family:'Playfair Display',serif;font-size:1.4rem;color:#1a1a2e;margin:0 0 4px;">Apertura de Turno</h2>
      <p style="font-size:.85rem;color:#888;margin:0 0 16px;">Hola, <strong><%= cajeroNombre %></strong> — elige tu caja para comenzar</p>

      <div id="turno-error" class="alert alert--error" style="display:none;margin-bottom:14px;"></div>

      <div style="background:#fdf5f7;border:1px solid #f5d0d8;border-radius:8px;padding:9px 13px;font-size:.82rem;color:#6C0820;display:flex;align-items:center;gap:8px;margin-bottom:16px;">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        <span id="turno-reloj"></span>
      </div>

      <div class="form-group">
        <label class="form-label" for="turno-caja">Caja <span class="required">*</span></label>
        <% if (cajas.length === 0) { %>
          <div class="alert alert--warning" style="margin:4px 0 0">
            No hay cajas activas. Pide al administrador que configure una en
            <a href="/admin/cajas" class="link">Admin → Cajas</a>.
          </div>
        <% } else { %>
          <select id="turno-caja" class="form-control">
            <option value="">Selecciona una caja…</option>
            <% cajas.forEach(c => { %>
              <option value="<%= c.id %>"><%= c.nombre %></option>
            <% }) %>
          </select>
        <% } %>
      </div>

      <div class="form-group" style="margin-top:14px;">
        <label class="form-label" for="turno-fondo">Fondo inicial en efectivo</label>
        <div class="input-money-wrap">
          <span class="input-money-prefix">$</span>
          <input type="number" id="turno-fondo" class="form-control form-control--money"
                 placeholder="0.00" min="0" step="0.01" value="0">
        </div>
      </div>

      <button id="turno-btn" onclick="abrirTurnoDesdeModal()"
              class="btn btn-primary btn-lg w-full"
              style="margin-top:22px;justify-content:center;"
              <%= cajas.length === 0 ? 'disabled' : '' %>>
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        Abrir Turno
      </button>

      <form method="POST" action="/auth/logout" style="text-align:center;margin-top:12px;">
        <button type="submit" class="btn btn-ghost" style="font-size:.78rem;color:#bbb;">Cerrar sesión</button>
      </form>
    </div>

  </div>
</div>

<script>
  function mostrarFormulario() {
    document.getElementById('turno-conectando').style.display = 'none';
    document.getElementById('turno-formulario').style.display = 'block';
    function tick() {
      const el = document.getElementById('turno-reloj');
      if (el) el.textContent = new Date().toLocaleString('es-MX', {
        weekday:'long', day:'2-digit', month:'long', year:'numeric',
        hour:'2-digit', minute:'2-digit', second:'2-digit',
      });
    }
    tick(); setInterval(tick, 1000);
  }

  const cajaGuardada = localStorage.getItem('smartventa_caja_id');
  if (cajaGuardada) {
    fetch('/venta/reconectar-turno', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ caja_id: cajaGuardada }),
    })
    .then(r => r.json())
    .then(data => {
      if (data.ok) { window.location.reload(); }
      else {
        mostrarFormulario();
        const sel = document.getElementById('turno-caja');
        if (sel) sel.value = cajaGuardada;
      }
    })
    .catch(() => {
      mostrarFormulario();
      const sel = document.getElementById('turno-caja');
      if (sel) sel.value = cajaGuardada;
    });
  } else {
    mostrarFormulario();
  }

  async function abrirTurnoDesdeModal() {
    const caja_id       = document.getElementById('turno-caja')?.value;
    const fondo_inicial = parseFloat(document.getElementById('turno-fondo')?.value) || 0;
    const errDiv        = document.getElementById('turno-error');
    const btn           = document.getElementById('turno-btn');

    if (!caja_id) {
      errDiv.textContent = 'Selecciona una caja antes de continuar.';
      errDiv.style.display = 'block'; return;
    }

    btn.disabled    = true;
    btn.textContent = 'Abriendo turno…';
    errDiv.style.display = 'none';

    try {
      const resp = await fetch('/venta/abrir-turno', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ caja_id, fondo_inicial }),
      });
      const data = await resp.json();
      if (!resp.ok || !data.ok) {
        errDiv.textContent   = data.error || 'No se pudo abrir el turno.';
        errDiv.style.display = 'block';
        btn.disabled = false;
        btn.innerHTML = '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg> Abrir Turno';
        return;
      }
      localStorage.setItem('smartventa_caja_id', caja_id);
      window.location.reload();
    } catch {
      errDiv.textContent   = 'Error de conexión. Intenta de nuevo.';
      errDiv.style.display = 'block';
      btn.disabled = false;
      btn.innerHTML = '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg> Abrir Turno';
    }
  }
</script>
<% } %>

<% if (typeof query !== 'undefined' && query?.limpiar_caja) { %>
<script>localStorage.removeItem('smartventa_caja_id');</script>
<% } %>

<%- include('../partials/footer') %>
