            <label>Efectivo</label>
            <div class="cobro-input-wrap cobro-input-wrap--sm">
              <span>$</span>
              <input type="number" id="cobro-mix-efectivo" class="cobro-input-monto" placeholder="0.00" min="0" step="0.01" oninput="actualizarRestante()">
            </div>
          </div>
          <div class="cobro-mixto-fila">
            <label>Tarjeta</label>
            <div class="cobro-input-wrap cobro-input-wrap--sm">
              <span>$</span>
              <input type="number" id="cobro-mix-tarjeta" class="cobro-input-monto" placeholder="0.00" min="0" step="0.01" oninput="actualizarRestante()">
            </div>
          </div>
          <div class="cobro-mixto-fila">
            <label>Transferencia</label>
            <div class="cobro-input-wrap cobro-input-wrap--sm">
              <span>$</span>
              <input type="number" id="cobro-mix-transferencia" class="cobro-input-monto" placeholder="0.00" min="0" step="0.01" oninput="actualizarRestante()">
            </div>
          </div>
          <div class="cobro-mixto-fila">
            <label>Cheque</label>
            <div class="cobro-input-wrap cobro-input-wrap--sm">
              <span>$</span>
              <input type="number" id="cobro-mix-cheque" class="cobro-input-monto" placeholder="0.00" min="0" step="0.01" oninput="actualizarRestante()">
            </div>
          </div>
          <div class="cobro-mixto-restante">
            <span>Restante</span>
