<%- include('../partials/header', { title }) %>

<style>
/* ═══════════════════════════════════════════
   PDV — Punto de Venta   |   venta/index.ejs
═══════════════════════════════════════════ */

/* ── Layout ──────────────────────────────── */
.pdv-page { display:flex; flex-direction:column; height:calc(100vh - var(--header-h)); overflow:hidden; padding:0; }
.pdv-body { display:grid; grid-template-columns:1fr 340px; flex:1; overflow:hidden; }

/* ── Barra superior ──────────────────────── */
.pdv-bar { display:flex; align-items:center; gap:10px; padding:10px 16px; background:#fff; border-bottom:1px solid #F2DCDB; flex-shrink:0; flex-wrap:wrap; }
.pdv-search-box { position:relative; flex:1; min-width:260px; }
.pdv-search-box svg { position:absolute; left:10px; top:50%; transform:translateY(-50%); color:#aaa; pointer-events:none; }
.pdv-search-input { width:100%; padding:8px 12px 8px 32px; border:1.5px solid #E0C8C8; border-radius:8px; font-size:.9rem; font-family:'DM Sans',sans-serif; }
.pdv-search-input:focus { outline:none; border-color:#B5294E; box-shadow:0 0 0 3px rgba(181,41,78,.1); }
.pdv-search-hint { position:absolute; top:calc(100% + 6px); left:0; font-size:.85rem; font-weight:500; color:#6C0820; background:#FCE4EE; border:1px solid #F4A0C0; padding:8px 14px; border-radius:8px; box-shadow:0 3px 10px rgba(0,0,0,.10); display:none; z-index:5; white-space:nowrap; }
.pdv-search-hint--visible { display:block; }
.pdv-bar__cliente { display:flex; align-items:center; gap:6px; flex-shrink:0; }
.pdv-bar__cliente label { font-size:.78rem; font-weight:600; color:#6C0820; white-space:nowrap; }
.pdv-bar__cliente select { padding:7px 10px; border:1.5px solid #E0C8C8; border-radius:8px; font-size:.82rem; font-family:'DM Sans',sans-serif; max-width:200px; }

/* ── Acciones rápidas ────────────────────── */
.pdv-acciones-bar { display:flex; gap:6px; padding:8px 16px; background:#fff; border-bottom:1px solid #F2DCDB; flex-shrink:0; flex-wrap:wrap; }
.pdv-accion-btn { display:flex; align-items:center; gap:5px; padding:6px 12px; border:1.5px solid #E0C8C8; border-radius:7px; background:#fff; color:#6C0820; font-size:.78rem; font-weight:600; cursor:pointer; transition:background .15s; text-decoration:none; }
.pdv-accion-btn:hover { background:#FCE4EE; }
.pdv-accion-btn--mayoreo.activo { background:#6C0820; color:#fff; }
.pdv-accion-btn kbd { font-size:.65rem; background:#F2DCDB; color:#6C0820; padding:1px 5px; border-radius:4px; }

/* ── Pestañas ────────────────────────────── */
.pdv-tabs { display:flex; align-items:center; gap:4px; padding:6px 16px 0; background:#fff; flex-shrink:0; overflow-x:auto; }
.pdv-tab { display:flex; align-items:center; gap:6px; padding:7px 14px; border-radius:8px 8px 0 0; background:#FAF5F5; color:#888; font-size:.8rem; font-weight:600; cursor:pointer; white-space:nowrap; border:1px solid #F2DCDB; border-bottom:none; flex-shrink:0; }
.pdv-tab--activa { background:#6C0820; color:#fff; border-color:#6C0820; }
.pdv-tab__close { display:flex; opacity:.6; }
.pdv-tab__close:hover { opacity:1; }
.pdv-tab-nueva { display:flex; align-items:center; justify-content:center; width:30px; height:30px; border-radius:6px; background:#FCE4EE; color:#6C0820; cursor:pointer; flex-shrink:0; }
.pdv-tab-nueva:hover { background:#F9B8D2; }

/* ── Ticket ──────────────────────────────── */
.pdv-ticket { display:flex; flex-direction:column; border-right:1px solid #F2DCDB; overflow:hidden; }
.pdv-ticket__header { display:grid; grid-template-columns:1fr 2fr 0.7fr 1fr 1fr 36px; padding:8px 12px; background:#6C0820; color:#fff; font-size:.72rem; font-weight:600; letter-spacing:.04em; text-transform:uppercase; flex-shrink:0; }
.pdv-ticket__body { flex:1; overflow-y:auto; }
.pdv-ticket__empty { display:flex; flex-direction:column; align-items:center; justify-content:center; height:100%; color:#ddd; gap:10px; }
.pdv-ticket__empty p { font-size:.88rem; color:#bbb; }

/* Filas del ticket */
.pdv-ticket-row { display:grid; grid-template-columns:1fr 2fr 0.7fr 1fr 1fr 36px; padding:8px 12px; border-bottom:1px solid #F7E7CE; align-items:center; transition:background .12s; cursor:pointer; }
.pdv-ticket-row:hover             { background:#FDF5F5; }
.pdv-ticket-row--selected         { background:#FCE4EE; outline:2px solid #B5294E; outline-offset:-2px; }
.pdv-ticket-row--mayoreo          { background:#FCE4EE; }
.pdv-ticket-row--mayoreo:hover    { background:#F9D5E5; }
.pdv-ticket-row--promo            { background:#ecfdf5; }
.pdv-ticket-row--promo:hover      { background:#d1fae5; }
.pdv-ticket-row--sin-stock        { background:#fee2e2 !important; outline:2px solid #ef4444; outline-offset:-2px; }
.pdv-ticket-row__codigo   { font-size:.68rem; color:#aaa; font-family:monospace; }
.pdv-ticket-row__nombre   { font-size:.85rem; font-weight:500; color:#3D5D91; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; padding-right:8px; }
.pdv-ticket-row__qty      { display:flex; align-items:center; gap:4px; }
.pdv-qty-btn { width:22px; height:22px; border:none; border-radius:4px; background:#F2DCDB; color:#6C0820; cursor:pointer; display:flex; align-items:center; justify-content:center; font-size:.85rem; font-weight:700; transition:background .12s; flex-shrink:0; }
.pdv-qty-btn:hover        { background:#FFB7C5; }
.pdv-qty-num              { width:26px; text-align:center; font-size:.85rem; font-weight:700; color:#333; }
.pdv-ticket-row__precio   { font-size:.8rem; color:#555; text-align:right; padding-right:4px; }
.pdv-ticket-row__subtotal { font-size:.85rem; font-weight:700; color:#B5294E; text-align:right; padding-right:4px; }
.pdv-ticket-row__del { background:none; border:none; color:#ddd; cursor:pointer; display:flex; align-items:center; justify-content:center; transition:color .12s; padding:4px; }
.pdv-ticket-row__del:hover { color:#ef4444; }

/* Tags de precio */
.tag-mayoreo { font-size:.62rem; background:#F2DCDB; color:#6C0820; padding:1px 5px; border-radius:4px; font-weight:700; }
.tag-forzado { font-size:.62rem; background:#6C0820; color:#fff;    padding:1px 5px; border-radius:4px; font-weight:700; }
.tag-promo   { font-size:.62rem; background:#d1fae5; color:#065f46; padding:1px 5px; border-radius:4px; font-weight:700; }

/* ── Footer del ticket ───────────────────── */
.pdv-footer { border-top:2px solid #F2DCDB; background:#fff; padding:12px 16px; flex-shrink:0; }
.pdv-footer__totales { display:flex; align-items:center; justify-content:space-between; gap:12px; }
.pdv-total-label { font-size:.8rem; color:#888; }
.pdv-total-monto { font-family:'Playfair Display',serif; font-size:1.6rem; font-weight:700; color:#6C0820; }
.pdv-btn-cobrar { padding:12px 28px; background:linear-gradient(135deg,#B5294E,#6C0820); color:#fff; border:none; border-radius:10px; font-size:1rem; font-weight:700; cursor:pointer; display:flex; align-items:center; gap:8px; transition:opacity .18s; white-space:nowrap; }
.pdv-btn-cobrar:disabled          { opacity:.4; cursor:default; }
.pdv-btn-cobrar:not(:disabled):hover { opacity:.9; }

/* ── Catálogo ────────────────────────────── */
.pdv-catalogo { display:flex; flex-direction:column; overflow:hidden; background:#FAF5F5; min-height:0; }
.pdv-catalogo__filtro select { width:100%; padding:6px 10px; border:1.5px solid #E0C8C8; border-radius:7px; font-size:.8rem; background:#fff; }
.pdv-catalogo__filtro { padding:8px 10px; border-bottom:1px solid #F2DCDB; flex-shrink:0; }
.pdv-catalogo__grid { flex:1; min-height:0; overflow-y:auto; padding:8px; display:grid; grid-template-columns:repeat(auto-fill,minmax(96px,1fr)); grid-auto-rows:130px; gap:8px; align-content:start; }
.pdv-catalogo__placeholder { grid-column:1/-1; display:flex; align-items:center; justify-content:center; padding:30px 10px; text-align:center; color:#bbb; font-size:.8rem; }
.pdv-mini-card { background:#fff; border-radius:8px; box-shadow:0 1px 3px rgba(60,40,50,.07); overflow:hidden; cursor:pointer; transition:box-shadow .15s,transform .15s; border:2px solid transparent; display:flex; flex-direction:column; min-width:0; height:130px; }
.pdv-mini-card:hover          { box-shadow:0 3px 10px rgba(108,8,32,.12); transform:translateY(-1px); border-color:#FFB7C5; }
.pdv-mini-card--agotado       { opacity:.5; cursor:default; pointer-events:none; }
.pdv-mini-card__img           { height:72px; flex-shrink:0; background:#F2DCDB; overflow:hidden; position:relative; }
.pdv-mini-card__img img       { width:100%; height:100%; object-fit:cover; }
.pdv-mini-card__img-placeholder { width:100%; height:100%; display:flex; align-items:center; justify-content:center; color:#C88; }
.pdv-mini-card__agotado       { position:absolute; inset:0; background:rgba(0,0,0,.4); display:flex; align-items:center; justify-content:center; color:#fff; font-size:.65rem; font-weight:700; }
.pdv-mini-card__info          { padding:5px 6px 7px; flex:1; }
.pdv-mini-card__nombre        { font-size:.7rem; font-weight:600; color:#3D5D91; line-height:1.2; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; margin-bottom:2px; }
.pdv-mini-card__precio        { font-size:.78rem; font-weight:700; color:#B5294E; }

/* ── Modal genérico — usado por movimientos de caja ── */
.pdv-modal-overlay { position:fixed; inset:0; background:rgba(0,0,0,.5); z-index:1000; display:flex; align-items:center; justify-content:center; padding:20px; }
.pdv-modal         { background:#fff; border-radius:16px; padding:28px; width:100%; max-width:460px; box-shadow:0 20px 60px rgba(0,0,0,.3); }
.pdv-modal__title  { font-family:'Playfair Display',serif; font-size:1.2rem; color:#6C0820; margin:0 0 20px; }
.pdv-modal__acciones { display:flex; gap:10px; margin-top:20px; }

/* ── Modal cobro rediseñado ──────────────── */
.cobro-modal { background:#fff; border-radius:16px; width:100%; max-width:680px; box-shadow:0 24px 80px rgba(0,0,0,.35); overflow:hidden; display:flex; flex-direction:column; }

.cobro-header { background:linear-gradient(135deg,#6C0820,#B5294E); padding:24px 32px; display:flex; align-items:center; justify-content:space-between; }
.cobro-header__label { color:rgba(255,255,255,.7); font-size:.85rem; display:block; }
.cobro-header__total { font-family:'Playfair Display',serif; font-size:2.8rem; font-weight:700; color:#fff; line-height:1; display:block; }
.cobro-header__meta  { display:flex; flex-direction:column; align-items:flex-end; gap:6px; }
.cobro-header__meta span { font-size:.82rem; color:rgba(255,255,255,.8); background:rgba(255,255,255,.15); padding:3px 10px; border-radius:12px; }

.cobro-metodos { display:flex; border-bottom:2px solid #F2DCDB; }
.cobro-metodo { flex:1; display:flex; flex-direction:column; align-items:center; gap:6px; padding:16px 8px; border:none; border-right:1px solid #F2DCDB; background:#FAF5F5; color:#888; cursor:pointer; transition:background .15s,color .15s; font-size:.78rem; font-weight:600; font-family:'DM Sans',sans-serif; }
.cobro-metodo:last-child { border-right:none; }
.cobro-metodo:hover      { background:#FCE4EE; color:#6C0820; }
.cobro-metodo--activo    { background:#fff; color:#6C0820; border-bottom:3px solid #B5294E; }

.cobro-panel { padding:28px 32px; min-height:180px; display:flex; flex-direction:column; gap:16px; }
.cobro-campo-grande label { font-size:.82rem; font-weight:600; color:#888; text-transform:uppercase; letter-spacing:.06em; display:block; margin-bottom:8px; }

.cobro-input-wrap { display:flex; align-items:center; border:2px solid #E0C8C8; border-radius:10px; overflow:hidden; transition:border-color .18s; }
.cobro-input-wrap:focus-within { border-color:#B5294E; }
.cobro-input-wrap span { padding:12px 16px; background:#FCE4EE; color:#6C0820; font-size:1.2rem; font-weight:700; border-right:2px solid #E0C8C8; flex-shrink:0; }
.cobro-input-wrap--sm span { padding:8px 10px; font-size:.9rem; }
.cobro-input-monto { flex:1; border:none; padding:12px 16px; font-size:1.6rem; font-family:'Playfair Display',serif; color:#6C0820; font-weight:700; outline:none; width:100%; }
.cobro-input-wrap--sm .cobro-input-monto { font-size:1rem; padding:8px 10px; }

.cobro-cambio-display { display:flex; align-items:center; justify-content:space-between; background:#d1fae5; border-radius:10px; padding:14px 20px; }
.cobro-cambio-display span   { font-size:.88rem; color:#065f46; font-weight:600; }
.cobro-cambio-display strong { font-size:1.5rem; color:#065f46; font-family:'Playfair Display',serif; }
.cobro-cambio-display--negativo { background:#fee2e2; }
.cobro-cambio-display--negativo span,
.cobro-cambio-display--negativo strong { color:#991b1b; }

.cobro-referencia label { font-size:.82rem; font-weight:600; color:#888; display:block; margin-bottom:6px; }
.cobro-input-ref { width:100%; padding:10px 14px; border:1.5px solid #E0C8C8; border-radius:8px; font-size:.9rem; font-family:'DM Sans',sans-serif; }
.cobro-input-ref:focus { outline:none; border-color:#B5294E; }

.cobro-mixto-grid { display:flex; flex-direction:column; gap:10px; }
.cobro-mixto-fila { display:grid; grid-template-columns:140px 1fr; align-items:center; gap:12px; }
.cobro-mixto-fila label { font-size:.85rem; font-weight:600; color:#555; }
.cobro-mixto-restante { display:flex; align-items:center; justify-content:space-between; padding:12px 16px; background:#F7E7CE; border-radius:8px; margin-top:4px; }
.cobro-mixto-restante span   { font-size:.9rem; font-weight:700; color:#6C0820; }
.cobro-mixto-restante strong { font-size:1.3rem; font-family:'Playfair Display',serif; color:#6C0820; }

.cobro-acciones { display:flex; border-top:2px solid #F2DCDB; }
.cobro-btn { flex:1; display:flex; align-items:center; justify-content:center; gap:10px; padding:18px 12px; border:none; border-right:1px solid #F2DCDB; background:#fff; cursor:pointer; transition:background .15s; font-family:'DM Sans',sans-serif; }
.cobro-btn:last-child { border-right:none; }
.cobro-btn > div { display:flex; flex-direction:column; align-items:flex-start; gap:2px; }
.cobro-btn__kbd { font-size:.68rem; font-weight:700; color:#888; text-transform:uppercase; letter-spacing:.06em; }
.cobro-btn--imprimir    { color:#6C0820; }
.cobro-btn--imprimir > div span:last-child  { font-size:.9rem; font-weight:700; }
.cobro-btn--imprimir:hover    { background:#FCE4EE; }
.cobro-btn--sin-imprimir { color:#065f46; }
.cobro-btn--sin-imprimir > div span:last-child { font-size:.9rem; font-weight:700; }
.cobro-btn--sin-imprimir:hover { background:#d1fae5; }
.cobro-btn--cancelar    { color:#888; }
.cobro-btn--cancelar > div span:last-child  { font-size:.9rem; font-weight:700; }
.cobro-btn--cancelar:hover    { background:#fee2e2; color:#991b1b; }

/* ── Toast ───────────────────────────────── */
.pdv-toast { position:fixed; bottom:24px; left:50%; transform:translateX(-50%) translateY(20px); background:#6C0820; color:#fff; padding:12px 22px; border-radius:10px; font-size:.88rem; font-weight:600; box-shadow:0 6px 20px rgba(0,0,0,.25); opacity:0; pointer-events:none; transition:opacity .2s,transform .2s; z-index:2000; white-space:nowrap; }
.pdv-toast--visible { opacity:1; transform:translateX(-50%) translateY(0); }

/* ── Overlay turno ───────────────────────── */
@keyframes spin { to { transform:rotate(360deg); } }
</style>

<!-- ══════════════════════════════════════
     LAYOUT PRINCIPAL
══════════════════════════════════════ -->
<div class="pdv-page">

  <!-- Barra superior: buscador + cliente + cerrar turno -->
  <div class="pdv-bar">
    <div class="pdv-search-box">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
      <input type="text" id="pdv-search" class="pdv-search-input"
             placeholder="Buscar por nombre o escanear código de barras…"
             autocomplete="off" autofocus>
      <div class="pdv-search-hint" id="pdv-search-hint">
        Coloca el símbolo % para buscar en todas las categorías
      </div>
    </div>
    <div class="pdv-bar__cliente">
      <label for="pdv-cliente">Cliente:</label>
      <select id="pdv-cliente" onchange="onClienteChange()">
        <option value="">Público general</option>
        <% clientes.forEach(c => { %>
          <option value="<%= c.id %>" data-nombre="<%= c.nombre %>" data-mayorista="<%= c.es_mayorista %>">
            <%= c.nombre %><%= c.es_mayorista ? ' ★' : '' %>
          </option>
        <% }) %>
      </select>
    </div>
    <a href="/turnos/cierre" class="pdv-accion-btn" style="border-color:#fca5a5;color:#b91c1c;flex-shrink:0;">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="8" y1="12" x2="16" y2="12"/></svg>
      Cerrar Turno
    </a>
  </div>

  <!-- Acciones rápidas (atajos de teclado) -->
  <div class="pdv-acciones-bar">
    <button class="pdv-accion-btn" onclick="vaciarTicketActivo()"><kbd>F4</kbd> Eliminar</button>
    <button class="pdv-accion-btn" onclick="aparcarTicketActivo()"><kbd>F6</kbd> Pendiente</button>
    <button class="pdv-accion-btn pdv-accion-btn--mayoreo" id="btn-forzar-mayoreo" onclick="toggleForzarMayoreo()"><kbd>F11</kbd> Mayoreo</button>
    <button class="pdv-accion-btn" onclick="abrirModalMovimiento('entrada')"><kbd>F7</kbd> Entradas</button>
    <button class="pdv-accion-btn" onclick="abrirModalMovimiento('salida')"><kbd>F8</kbd> Salidas</button>
    <button class="pdv-accion-btn" onclick="abrirVerificador()"><kbd>F9</kbd> Verificador</button>
    <button class="pdv-accion-btn" onclick="reimprimirUltimo()">Reimprimir Último Ticket</button>
    <a href="/ventas-dia" class="pdv-accion-btn">Ventas del día y Devoluciones</a>
  </div>

  <!-- Pestañas de tickets en paralelo -->
  <div class="pdv-tabs" id="pdv-tabs"></div>

  <!-- Cuerpo: ticket activo | catálogo -->
  <div class="pdv-body">

    <!-- Izquierda: ticket -->
    <div class="pdv-ticket">
      <div class="pdv-ticket__header">
        <span>Código</span><span>Producto</span>
        <span style="text-align:center">Cant.</span>
        <span style="text-align:right">Precio</span>
        <span style="text-align:right">Subtotal</span>
        <span></span>
      </div>
      <div class="pdv-ticket__body" id="ticket-body"></div>
      <div class="pdv-footer">
        <div class="pdv-footer__totales">
          <div>
            <div class="pdv-total-label">Total</div>
            <div class="pdv-total-monto" id="pdv-total">$0.00</div>
          </div>
          <button class="pdv-btn-cobrar" id="btn-cobrar" onclick="abrirModalCobro()" disabled>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
            Cobrar  <small style="font-size:.68rem;opacity:.7">F12</small>
          </button>
        </div>
      </div>
    </div>

    <!-- Derecha: catálogo -->
    <div class="pdv-catalogo">
      <div class="pdv-catalogo__filtro">
        <select id="filtro-categoria" onchange="dispararBusqueda()">
          <option value="">Todas las categorías</option>
          <% categorias.forEach(cat => { %>
            <option value="<%= cat.id %>"><%= cat.nombre %></option>
          <% }) %>
        </select>
      </div>
      <div class="pdv-catalogo__grid" id="catalogo-grid">
        <div class="pdv-catalogo__placeholder">
          <p>Busca un producto por nombre/código o selecciona una categoría.</p>
        </div>
      </div>
    </div>

  </div>
</div>

<!-- ══════════════════════════════════════
     MODAL COBRO
══════════════════════════════════════ -->
<div class="pdv-modal-overlay" id="modal-cobro" style="display:none">
  <div class="cobro-modal">

    <div class="cobro-header">
      <div>
        <span class="cobro-header__label">Total a cobrar</span>
        <span class="cobro-header__total" id="cobro-total">$0.00</span>
      </div>
      <div class="cobro-header__meta">
        <span id="cobro-num-articulos">0 artículos</span>
        <span id="cobro-cliente-label">Público general</span>
      </div>
    </div>

    <div class="cobro-metodos">
      <button class="cobro-metodo cobro-metodo--activo" id="cmet-efectivo" onclick="seleccionarMetodoCobro('efectivo')">
        <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="6" width="20" height="12" rx="2"/><path d="M22 10H2"/><circle cx="12" cy="14" r="2"/></svg>
        <span>Efectivo</span>
      </button>
      <button class="cobro-metodo" id="cmet-tarjeta" onclick="seleccionarMetodoCobro('tarjeta')">
        <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="1" y="4" width="22" height="16" rx="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>
        <span>Tarjeta</span>
      </button>
      <button class="cobro-metodo" id="cmet-transferencia" onclick="seleccionarMetodoCobro('transferencia')">
        <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polyline points="17 1 21 5 17 9"/><path d="M3 11V9a4 4 0 014-4h14"/><polyline points="7 23 3 19 7 15"/><path d="M21 13v2a4 4 0 01-4 4H3"/></svg>
        <span>Transferencia</span>
      </button>
      <button class="cobro-metodo" id="cmet-cheque" onclick="seleccionarMetodoCobro('cheque')">
        <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
        <span>Cheque</span>
      </button>
      <button class="cobro-metodo" id="cmet-mixto" onclick="seleccionarMetodoCobro('mixto')">
        <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/></svg>
        <span>Mixto</span>
      </button>
    </div>

    <div class="cobro-panel">

      <!-- Efectivo / Tarjeta / Transferencia / Cheque -->
      <div id="cobro-panel-simple">
        <div class="cobro-campo-grande">
          <label id="cobro-pago-label">Pagó con</label>
