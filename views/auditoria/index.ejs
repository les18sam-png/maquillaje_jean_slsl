<%- include('../partials/header') %>

<main class="contenido">

  <div class="page-header flex-between">
    <div>
      <h1 class="page-title">Auditoría</h1>
      <p class="page-subtitle">Historial inmutable de acciones críticas del sistema</p>
    </div>
  </div>

  <!-- FILTROS -->
  <div class="card">
    <div class="card-titulo">Filtrar registros</div>
    <form method="GET" action="/auditoria" class="auditoria-filtros">
        <div class="form-group">
        <label>Módulo</label>
        <select name="modulo">
          <option value="">Todos</option>
          <option value="ventas" <%= filtros.modulo === 'ventas' ? 'selected' : '' %>>Ventas</option>
          <option value="inventario" <%= filtros.modulo === 'inventario' ? 'selected' : '' %>>Inventario</option>
          <option value="productos" <%= filtros.modulo === 'productos' ? 'selected' : '' %>>Productos</option>
          <option value="categorias" <%= filtros.modulo === 'categorias' ? 'selected' : '' %>>Categorías</option>
          <option value="promociones" <%= filtros.modulo === 'promociones' ? 'selected' : '' %>>Promociones</option>
          <option value="movimientos_caja" <%= filtros.modulo === 'movimientos_caja' ? 'selected' : '' %>>Movimientos de caja</option>
        </select>
      </div>
      
       <div class="form-group">
        <label>Acción</label>
        <select name="accion">
          <option value="">Todas</option>

          <optgroup label="Categorías">
            <option value="crear_categoria" <%= filtros.accion === 'crear_categoria' ? 'selected' : '' %>>Crear categoría</option>
            <option value="actualizar_categoria" <%= filtros.accion === 'actualizar_categoria' ? 'selected' : '' %>>Actualizar categoría</option>
            <option value="eliminar_categoria" <%= filtros.accion === 'eliminar_categoria' ? 'selected' : '' %>>Eliminar categoría</option>
          </optgroup>

          <optgroup label="Productos">
            <option value="crear_producto" <%= filtros.accion === 'crear_producto' ? 'selected' : '' %>>Crear producto</option>
            <option value="actualizar_producto" <%= filtros.accion === 'actualizar_producto' ? 'selected' : '' %>>Actualizar producto</option>
            <option value="desactivar_producto" <%= filtros.accion === 'desactivar_producto' ? 'selected' : '' %>>Desactivar producto</option>
            <option value="importar_productos" <%= filtros.accion === 'importar_productos' ? 'selected' : '' %>>Importar productos</option>
          </optgroup>

          <optgroup label="Inventario">
            <option value="entrada_mercancia" <%= filtros.accion === 'entrada_mercancia' ? 'selected' : '' %>>Entrada de mercancía</option>
            <option value="ajuste_inventario" <%= filtros.accion === 'ajuste_inventario' ? 'selected' : '' %>>Ajuste de inventario</option>
          </optgroup>

          <optgroup label="Promociones">
            <option value="crear_promocion" <%= filtros.accion === 'crear_promocion' ? 'selected' : '' %>>Crear promoción</option>
            <option value="actualizar_promocion" <%= filtros.accion === 'actualizar_promocion' ? 'selected' : '' %>>Actualizar promoción</option>
            <option value="eliminar_promocion" <%= filtros.accion === 'eliminar_promocion' ? 'selected' : '' %>>Eliminar promoción</option>
          </optgroup>

          <optgroup label="Ventas">
            <option value="crear_venta" <%= filtros.accion === 'crear_venta' ? 'selected' : '' %>>Crear venta</option>
            <option value="registrar_devolucion" <%= filtros.accion === 'registrar_devolucion' ? 'selected' : '' %>>Registrar devolución</option>
          </optgroup>

          <optgroup label="Movimientos de caja">
            <option value="registrar_movimiento_manual" <%= filtros.accion === 'registrar_movimiento_manual' ? 'selected' : '' %>>Registrar movimiento manual</option>
          </optgroup>
        </select>
      </div> 

      <div class="form-group">
        <label>Desde</label>
        <input type="date" name="fecha_inicio" value="<%= filtros.fecha_inicio || '' %>">
      </div>

      <div class="form-group">
        <label>Hasta</label>
        <input type="date" name="fecha_fin" value="<%= filtros.fecha_fin || '' %>">
      </div>

      <div class="form-group">
        <label>Caja</label>
        <select name="caja_id">
          <option value="">Todas</option>
          <% cajas.forEach(c => { %>
            <option value="<%= c.id %>" <%= filtros.caja_id === c.id ? 'selected' : '' %>><%= c.nombre %></option>
          <% }) %>
        </select>
      </div>

      <% if (usuarios.length > 0) { %>
      <div class="form-group">
        <label>Usuario</label>
        <select name="usuario_id">
          <option value="">Todos</option>
          <% usuarios.forEach(u => { %>
            <option value="<%= u.id %>" <%= filtros.usuario_id === u.id ? 'selected' : '' %>><%= u.nombre_completo || u.nombre %></option>
          <% }) %>
        </select>
      </div>
      <% } %>

      <div class="form-group auditoria-filtros-btns">
        <button type="submit" class="btn btn-primary">Filtrar</button>
        <a href="/auditoria" class="btn btn-ghost">Limpiar</a>
      </div>
    </form>
  </div>

  <!-- TABLA -->
  <div class="card">
    <div class="card-titulo">
      Registros
      <span class="badge-count"><%= total %></span>
    </div>
    <div class="tabla-wrap">
      <table class="tabla">
        <thead>
          <tr>
            <th>Fecha y hora</th>
            <th>Usuario</th>
            <th>Módulo</th>
            <th>Acción</th>
            <th>Caja</th>
            <th>Detalle</th>
          </tr>
        </thead>
        <tbody>
        <% if (registros.length === 0) { %>
          <tr>
            <td colspan="6" class="text-center text-muted" style="padding:2rem;">
              No hay registros de auditoría con estos filtros
            </td>
          </tr>
        <% } else { %>
          <% registros.forEach(r => { %>
            <tr>
              <td class="text-muted" style="white-space:nowrap;">
                <%= new Date(r.fecha_hora + 'Z').toLocaleString('es-MX', { timeZone: 'America/Mexico_City' }) %>
              </td>
              <td style="font-size:.82rem;"><%= r.usuario_nombre || r.usuario_id %></td>
              <td>
                <span class="modulo-badge" data-modulo="<%= r.modulo %>"><%= r.modulo %></span>
              </td>
              <td class="text-muted" style="font-size:.82rem;"><%= r.accion %></td>
              <td class="text-muted" style="font-size:.82rem;"><%= r.caja_nombre || '—' %></td>
              <td>
                <button type="button" class="btn btn-ghost btn-sm"
                  onclick='mostrarDetalle(<%- JSON.stringify(r.valores_anteriores || {}) %>, <%- JSON.stringify(r.valores_nuevos || {}) %>)'>
                  Ver
                </button>
              </td>
            </tr>
          <% }) %>
        <% } %>
      </tbody>
      </table>
    </div>

    <% if (totalPaginas > 1) { %>
    <div class="auditoria-paginacion">
      <% if (pagina > 1) { %>
        <a class="btn btn-ghost btn-sm" href="/auditoria?<%= new URLSearchParams({...filtros, pagina: pagina - 1}).toString() %>">← Anterior</a>
      <% } %>
      <span class="text-muted" style="font-size:.82rem;">Página <%= pagina %> de <%= totalPaginas %> (<%= total %> registros)</span>
      <% if (pagina < totalPaginas) { %>
        <a class="btn btn-ghost btn-sm" href="/auditoria?<%= new URLSearchParams({...filtros, pagina: pagina + 1}).toString() %>">Siguiente →</a>
      <% } %>
    </div>
    <% } %>
  </div>

</main>

<!-- MODAL DETALLE -->
<div id="modalDetalle" class="modal-overlay oculto">
  <div class="modal-caja">
    <div class="modal-header">
      <span class="card-titulo" style="margin:0;">Detalle del cambio</span>
      <button type="button" class="modal-cerrar-x" onclick="cerrarDetalle()">&times;</button>
    </div>
    <div class="modal-body">
      <div class="modal-columna">
        <div class="modal-columna-titulo">Valores anteriores</div>
        <pre id="valoresAnteriores" class="modal-pre"></pre>
      </div>
      <div class="modal-columna">
        <div class="modal-columna-titulo">Valores nuevos</div>
        <pre id="valoresNuevos" class="modal-pre"></pre>
      </div>
    </div>
    <div class="modal-footer">
      <button type="button" class="btn btn-primary" onclick="cerrarDetalle()">Cerrar</button>
    </div>
  </div>
</div>

<style>
  .auditoria-filtros { display: flex; flex-wrap: wrap; gap: 1rem; align-items: flex-end; }
  .auditoria-filtros .form-group { min-width: 150px; }
  .auditoria-filtros-btns { display: flex; flex-direction: row; gap: .5rem; align-items: flex-end; }

  .badge-count { display: inline-flex; align-items: center; justify-content: center; background: var(--burgundy); color: white; font-size: .72rem; font-weight: 700; width: 22px; height: 22px; border-radius: 50%; margin-left: .5rem; }

  .btn-sm { padding: .35rem .75rem; font-size: .78rem; }

  .modulo-badge { font-size: .72rem; padding: 2px 10px; border-radius: 20px; font-weight: 600; text-transform: capitalize; background: #f5f5f5; color: #666; }
  .modulo-badge[data-modulo="ventas"]       { background: #ffeaea; color: #c0392b; }
  .modulo-badge[data-modulo="inventario"]   { background: #fff3cd; color: #856404; }
  .modulo-badge[data-modulo="productos"]    { background: #e8f4fd; color: #1a6fa8; }
  .modulo-badge[data-modulo="clientes"]     { background: #e6f9e6; color: #2d7a2d; }
  .modulo-badge[data-modulo="promociones"]  { background: #fdeafd; color: #a23fa2; }
  .modulo-badge[data-modulo="cortes"]       { background: #eee8fd; color: #5b3fa2; }
  .modulo-badge[data-modulo="turnos"]       { background: #e0f7f5; color: #158a7c; }
  .modulo-badge[data-modulo="usuarios"]     { background: #fde8ef; color: var(--burgundy); }

  .auditoria-paginacion { display: flex; align-items: center; justify-content: center; gap: 1rem; padding: 1rem 0 .25rem; }

  .modal-overlay { position: fixed; inset: 0; background: rgba(0,0,0,.4); display: flex; align-items: center; justify-content: center; z-index: 1000; }
  .modal-overlay.oculto { display: none; }
  .modal-caja { background: white; border-radius: 12px; width: min(700px, 92vw); max-height: 80vh; display: flex; flex-direction: column; box-shadow: 0 8px 30px rgba(0,0,0,.2); }
  .modal-header { display: flex; justify-content: space-between; align-items: center; padding: 1rem 1.25rem; border-bottom: 1px solid #eee; }
  .modal-cerrar-x { background: none; border: none; font-size: 1.4rem; line-height: 1; cursor: pointer; color: #999; }
  .modal-body { display: flex; gap: 1rem; padding: 1.25rem; overflow-y: auto; }
  .modal-columna { flex: 1; min-width: 0; }
  .modal-columna-titulo { font-weight: 700; font-size: .82rem; color: var(--burgundy); margin-bottom: .4rem; }
  .modal-pre { background: #faf5f6; border: 1px solid #eee; border-radius: 8px; padding: .75rem; font-size: .78rem; white-space: pre-wrap; word-break: break-word; max-height: 300px; overflow-y: auto; }
  .modal-footer { padding: .75rem 1.25rem; border-top: 1px solid #eee; text-align: right; }
  .modulo-badge[data-modulo="categorias"]      { background: #e0f0fd; color: #1a6fa8; }
.modulo-badge[data-modulo="movimientos_caja"]{ background: #fff0e0; color: #b8630a; }
</style>

<script>
  function mostrarDetalle(anteriores, nuevos) {
    document.getElementById('valoresAnteriores').textContent = JSON.stringify(anteriores, null, 2);
    document.getElementById('valoresNuevos').textContent = JSON.stringify(nuevos, null, 2);
    document.getElementById('modalDetalle').classList.remove('oculto');
  }
  function cerrarDetalle() {
    document.getElementById('modalDetalle').classList.add('oculto');
  }
</script>

<%- include('../partials/footer') %>